	if(PLAYER_DATA[params[0]][data_LOGGED] == false) return  SendClientMessage(playerid,COLOR_WARNING,"Äàííûé èãðîê íå ïðîøåë àâòîðèçàöèþ!");
	if(PLAYER_DATA[playerid][data_RANK] < 2 && PLAYER_DATA[playerid][data_MEMBER] != 8) return SendClientMessage(playerid,COLOR_WARNING,"Âàø ðàíã ñëèøêîì ìàë äëÿ èñïîëüçîâàíèÿ äàííîé êîìàíäû!");
