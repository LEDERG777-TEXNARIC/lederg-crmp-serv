CMD:h(playerid)
{
    if(antiflood[playerid] > 0) return SendClientMessage(playerid, COLOR_WARNING,"Íå ôëóäè!");
    antiflood[playerid]++;
    if(PLAYER_DATA[playerid][data_LOGGED] == false) return SendClientMessage(playerid,COLOR_WARNING,"Âû íå àâòîðèçîâàíû íà ñåðâåðå!");
	if(PLAYER_DATA[playerid][data_PHONE] == 0) return SendClientMessage(playerid,COLOR_WARNING,"Ó Âàñ íåò òåëåôîíà!");
	if(PLAYER_DATA[playerid][data_NUMBER] == 0) return SendClientMessage(playerid,COLOR_WARNING,"Ó Âàñ íåò SIM êàðòû!");
	if(PLAYER_DATA[playerid][data_CALL] == -1) return SendClientMessage(playerid,COLOR_WARNING,"Âû íå ðàçãîâàðèâàåòå ïî òåëåôîíó!");
	new id = PLAYER_DATA[playerid][data_CALL];
	if(!IsPlayerInAnyVehicle(playerid)) SetPlayerSpecialAction(playerid, SPECIAL_ACTION_STOPUSECELLPHONE);
	if(PLAYER_DATA[id][data_CALL] == playerid)
 	{
    	if(!IsPlayerInAnyVehicle(id)) SetPlayerSpecialAction(id, SPECIAL_ACTION_STOPUSECELLPHONE);
 	}
 	PLAYER_DATA[id][data_CALL] = -1;
 	PLAYER_DATA[playerid][data_CALL] = -1;
	SetPVarInt(id,"call_m",0);
	SetPVarInt(playerid,"call_m",0);
	SendClientMessage(playerid,0xFF6633FF,"Âû ïîëîæèëè òðóáêó");
	SendClientMessage(id,0xFF6633FF,"Âàø ñîáåñåäíèê ïîëîæèë òðóáêó");
	return true;
}

CMD:sms(playerid,params[])
{
    if(antiflood[playerid] > 0) return SendClientMessage(playerid, COLOR_WARNING,"Íå ôëóäè!");
    antiflood[playerid]++;
	if(PLAYER_DATA[playerid][data_LOGGED] == false) return SendClientMessage(playerid,COLOR_WARNING,"Âû íå àâòîðèçîâàíû íà ñåðâåðå!");
    if(PLAYER_DATA[playerid][data_MUTE] == 1) return SendClientMessage(playerid,COLOR_WARNING,"Âàø ÷àò âðåìåííî çàáëîêèðîâàí!");
	if(sscanf(params, "ds[84]", params[0],params[1])) return SendClientMessage(playerid, COLOR_WARNING, "Èñïîëüçóéòå: /sms [íîìåð] [òåêñò]");
    if(PLAYER_DATA[playerid][data_PHONE] == 0) return SendClientMessage(playerid,COLOR_WARNING,"Ó Âàñ íåò òåëåôîíà!");
	if(PLAYER_DATA[playerid][data_NUMBER] == 0) return SendClientMessage(playerid,COLOR_WARNING,"Ó Âàñ íåò SIM êàðòû!");
    if(PLAYER_DATA[playerid][data_NUMBER] == params[0]) return SendClientMessage(playerid,COLOR_WARNING,"Íåëüçÿ îòïðàâèòü SMS ñàìîìó ñåáå!");
    
    if(params[0] == 555)
	{
	    if(efir == false) return SendClientMessage(playerid,COLOR_WARNING,"Â äàííûé ìîìåíò äåéñòâóùèõ ýôèðîâ íåò!");
	    if(efir_sms == false) return SendClientMessage(playerid,COLOR_WARNING,"Ïðèåì SMS îòêëþ÷åí!");
	    if(PLAYER_DATA[playerid][data_NUMBER_M] <= 0) return SendClientMessage(playerid,COLOR_WARNING,"Ó Âàñ çàêîí÷èëèñü äåíüãè íà òåëåôîíå!");
		new message[145],message2[145],id = efir_ved;
		format(message,sizeof(message),"[ÑÌÑ]: %s | %s[%d](%d) <<<",params[1],PLAYER_DATA[playerid][data_NAME],playerid,PLAYER_DATA[playerid][data_NUMBER]);
		SendClientMessage(id,0xFFFF33FF,message);
		format(message2,sizeof(message2),"[ÑÌÑ] %s | %s[%d](%d) >>>",params[1],PLAYER_DATA[id][data_NAME],id,params[0]);
		SendClientMessage(playerid,0xFFFF33FF,message2);
		PLAYER_DATA[playerid][data_NUMBER_M]--;
		PlayerPlaySound(efir_ved, 40407, 0.0, 0.0, 0.0);
		return true;
	}
	
	
	for(new i = 0; i < MAX_PLAYERS; i++)
	{
	    if(!IsPlayerConnected(i)) continue;
		if(PLAYER_DATA[i][data_NUMBER] == params[0])
 		{
   			if(PLAYER_DATA[playerid][data_NUMBER_M] <= 0) return SendClientMessage(playerid,COLOR_WARNING,"Ó Âàñ çàêîí÷èëèñü äåíüãè íà ñ÷åòó!");
			new message[145],message2[145];
   			format(message,sizeof(message),"[ÑÌÑ]: %s | %s[%d](%d) <<<",params[1],PLAYER_DATA[playerid][data_NAME],playerid,PLAYER_DATA[playerid][data_NUMBER]);
			SendClientMessage(params[0],0xFFFF33FF,message);
			format(message2,sizeof(message2),"[ÑÌÑ] %s | %s[%d](%d) >>>",params[1],PLAYER_DATA[i][data_NAME],params[0],PLAYER_DATA[i][data_NUMBER]);
			SendClientMessage(playerid,0xFFFF33FF,message2);
			PLAYER_DATA[playerid][data_NUMBER_M]--;
			PlayerPlaySound(i, 40407, 0.0, 0.0, 0.0);
			return true;
  		}
	}
	SendClientMessage(playerid,COLOR_WARNING,"Äàííîãî èãðîêà íåò íà ñåðâåðå!");
	return true;
}

CMD:number(playerid, params[])
{
    if(antiflood[playerid] > 0) return SendClientMessage(playerid, COLOR_WARNING,"Íå ôëóäè!");
    antiflood[playerid]++;
    if(PLAYER_DATA[playerid][data_LOGGED] == false) return SendClientMessage(playerid,COLOR_WARNING,"Âû íå àâòîðèçîâàíû íà ñåðâåðå!");
	if(PLAYER_DATA[playerid][data_PHONEBOOK] == 0) return SendClientMessage(playerid,COLOR_WARNING,"Ó Âàñ íåò òåëåôîííîé êíèãè!");
	if(sscanf(params, "s[24]", params[0])) return SendClientMessage(playerid,COLOR_WARNING,"Èñïîëüçóéòå: /number [èìÿ]");
	new count = 0;
    for(new i = 0; i < MAX_PLAYERS; i++)
    {
        if(!IsPlayerConnected(i)) continue;
        if(strfind(PLAYER_DATA[i][data_NAME], params[0], true) == 0)
        {
            if(PLAYER_DATA[i][data_NUMBER] == 0) return SendClientMessage(playerid,COLOR_WARNING,"Ó äàííîãî èãðîêà íåò íîìåðà òåëåôîíà");
            count++;
            new str[MAX_PLAYER_NAME+15];
            format(str,sizeof(str),"%s - %d",PLAYER_DATA[i][data_NAME],PLAYER_DATA[i][data_NUMBER]);
            SendClientMessage(playerid, 0x99FF33FF , str);
			return true;
        }
    }
    if(count == 0) return SendClientMessage(playerid, COLOR_WARNING, "Èãðîê íå íàéäåí!");
    return true;
}

CMD:fuelcar(playerid, params[])
{
    if(antiflood[playerid] > 0) return SendClientMessage(playerid, COLOR_WARNING,"Íå ôëóäè!");
    antiflood[playerid]++;
    if(PLAYER_DATA[playerid][data_LOGGED] == false) return SendClientMessage(playerid,COLOR_WARNING,"Âû íå àâòîðèçîâàíû íà ñåðâåðå!");
    if(PLAYER_DATA[playerid][data_KANISTRA] == 0) return SendClientMessage(playerid, COLOR_WARNING, "Ó Âàñ íåò êàíèñòðû. Êóïèòü åå ìîæíî íà ëþáîì ÀÇÑ îáëàñòè!");
	new carid = GetPlayerVehicleID(playerid);
	if(carid == INVALID_VEHICLE_ID) return SendClientMessage(playerid, COLOR_WARNING, "Íóæíî íàõîäèòüñÿ â àâòîìîáèëå!");
	if(CAR_DATA[carid][data_FUEL] == 50) return SendClientMessage(playerid, COLOR_WARNING, "Áàê àâòîìîáèëÿ ïîëîí!");
	if(CAR_DATA[carid][data_FUEL] < 50 && CAR_DATA[carid][data_FUEL] >= 40) CAR_DATA[carid][data_FUEL] = 50;
	else CAR_DATA[carid][data_FUEL] += 10;
	SendClientMessage(playerid, 0x66CC00FF, "Âû çàïðàâèëè ñâîé àâòîìîáèëü");
	PLAYER_DATA[playerid][data_KANISTRA] = 0;
	return true;
}

CMD:healcar(playerid, params[])
{
    if(antiflood[playerid] > 0) return SendClientMessage(playerid, COLOR_WARNING,"Íå ôëóäè!");
    antiflood[playerid]++;
    if(PLAYER_DATA[playerid][data_LOGGED] == false) return SendClientMessage(playerid,COLOR_WARNING,"Âû íå àâòîðèçîâàíû íà ñåðâåðå!");
    if(PLAYER_DATA[playerid][data_ZAPCHASTI] == 0) return SendClientMessage(playerid, COLOR_WARNING, "Ó Âàñ íåò èíñòðóìåíòîâ. Êóïèòü èõ ìîæíî íà ëþáîì ÀÇÑ îáëàñòè!");
	new carid = GetPlayerVehicleID(playerid);
	new Float:hpc;
	if(carid == INVALID_VEHICLE_ID) return SendClientMessage(playerid, COLOR_WARNING, "Íóæíî íàõîäèòüñÿ â àâòîìîáèëå!");
    GetVehicleHealth(carid,hpc);
