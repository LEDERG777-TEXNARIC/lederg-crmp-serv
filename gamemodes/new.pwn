CMD:admins(playerid)
{
    if(antiflood[playerid] > 0) return SendClientMessage(playerid, COLOR_WARNING,"Íå ôëóäè!");
    antiflood[playerid]++;
    if(PLAYER_DATA[playerid][data_LOGGED] == false) return SendClientMessage(playerid,COLOR_WARNING,"Âû íå àâòîðèçîâàíû íà ñåðâåðå!");
    if(PLAYER_DATA[playerid][data_ADMLVL] < 1 && PLAYER_DATA[playerid][data_VIP] == 0) return true;
    new string[512];
    for(new i = 0; i < MAX_PLAYERS; i++)
    {
        if(!IsPlayerConnected(i)) continue;
        new atext[64];
        if(PLAYER_DATA[i][data_ADMLVL] != 0)
        {
            switch(PLAYER_DATA[i][data_ADMLVL])
            {
                case 1: atext = "Õåëïåð";
                case 2: atext = "Àäìèíèñòðàòîð";
                case 3: atext = "Àäìèíèñòðàòîð";
                case 4: atext = "Àäìèíèñòðàòîð";
                case 5: atext = "Àäìèíèñòðàòîð";
                case 6: atext = "Ãë.Àäìèíèñòðàòîð";
                case 7: atext = "Ðóêîâîäèòåëü";
            }
            
			if(PLAYER_DATA[i][data_AFK] > 2)
			{
            	format(string,sizeof(string),"%s{FFFFFF}(%d admlvl) %s: %s[%d] {FF3333}[AFK: %d]\n",string,PLAYER_DATA[i][data_ADMLVL],atext,PLAYER_DATA[i][data_NAME],i,PLAYER_DATA[i][data_AFK]);
            }
            else
            {
                format(string,sizeof(string),"%s{FFFFFF}(%d admlvl) %s: %s[%d]\n",string,PLAYER_DATA[i][data_ADMLVL],atext,PLAYER_DATA[i][data_NAME],i);
            }
		}
    }
    ShowPlayerDialogFix(playerid,dialog_ADMINS, DIALOG_STYLE_MSGBOX, "{FFCC00}Àäìèíèñòðàòîðû îíëàéí", string, "Çàêðûòü", "");
	return true;
}

CMD:warn(playerid,params[])
{
    if(antiflood[playerid] > 0) return SendClientMessage(playerid, COLOR_WARNING,"Íå ôëóäè!");
    antiflood[playerid]++;
    if(PLAYER_DATA[playerid][data_LOGGED] == false) return SendClientMessage(playerid,COLOR_WARNING,"Âû íå àâòîðèçîâàíû íà ñåðâåðå!");
    if(PLAYER_DATA[playerid][data_ADMLVL] < 3) return true;
	if(sscanf(params,"us[100]",params[0],params[1])) return SendClientMessage(playerid,COLOR_WARNING,"Èñïîëüçóéòå: /warn [èä] [ïðè÷èíà]");
	if(!IsPlayerConnected(params[0]))return  SendClientMessage(playerid,COLOR_WARNING,"Äàííîãî ID íåò íà ñåðâåðå!");
	if(PLAYER_DATA[params[0]][data_LOGGED] == false)return  SendClientMessage(playerid,COLOR_WARNING,"Äàííûé èãðîê íå ïðîøåë àâòîðèçàöèþ!");
    if(playerid == params[0]) return SendClientMessage(playerid,COLOR_WARNING,"Íåëüçÿ ïðèìèíèòü íà ñåáå!");
    if(PLAYER_DATA[params[0]][data_ADMLVL] > PLAYER_DATA[playerid][data_ADMLVL]) return SendClientMessage(playerid, COLOR_WARNING, "Íåëüçÿ ïðèìåíèòü ê ñòàðøåé àäìèíèñòðàöèè!");
    PLAYER_DATA[params[0]][data_MEMBER] = 0;
    PLAYER_DATA[params[0]][data_PODMEMBER] = 0;
	PLAYER_DATA[params[0]][data_LEADER] = 0;
	PLAYER_DATA[params[0]][data_RANK] = 0;
	PLAYER_DATA[params[0]][data_ADMLVL] = 0;

	if(PLAYER_DATA[params[0]][data_WARN] < 3)
	{
	    PLAYER_DATA[params[0]][data_WARN]++;
	    PLAYER_DATA[params[0]][data_WARNTIME] += 1200;
	    for(new i = 0; i < MAX_PLAYERS; i++)
		{
			if(!IsPlayerConnected(i)) continue;
			if(GetPVarInt(i,"gPlayerAaction") == 0)
	  		{
	    		new string[145];
				format(string, sizeof(string), "Àäìèíèñòðàòîð %s âûäàë ïðåäóïðåæäåíèå %s [%d|3]. Ïðè÷èíà: %s",PLAYER_DATA[playerid][data_NAME],PLAYER_DATA[params[0]][data_NAME],PLAYER_DATA[params[0]][data_WARN],params[1]);
				SendClientMessage(i,COLOR_AC,string);
			}
		}

	    SendClientMessage(params[0],COLOR_WARNING,"Äëÿ ïðîñìîòðà èíôîðìàöèè î ïðåäóïðåæäåíèè, èñïîëüçóéòå: /warntime");
	    SendClientMessage(params[0],COLOR_WARNING,"Äî ñíÿòèÿ âñåõ ïðåäóïðåæäåíèé çàïðåùåíî âñòóïàòü âî ôðàêöèè");
	    Kick(params[0]);
	    return true;
	}
	
	if(PLAYER_DATA[params[0]][data_WARN] >= 3)
	{
	 	new query[256];
	    mysql_format(dbHandle,query, sizeof(query), "INSERT INTO `banlist` ( `name`,`admin`, `day`, `text`, `ip`) VALUES ( '%e', '%e', '30', '%e', '%e')",PLAYER_DATA[params[0]][data_NAME],PLAYER_DATA[playerid][data_NAME],params[2],PLAYER_DATA[params[0]][data_LOGIN_IP]);
	    mysql_function_query(dbHandle, query, false, "", "");
		Kick(params[0]);

		for(new i = 0; i < MAX_PLAYERS; i++)
		{
			if(!IsPlayerConnected(i)) continue;
			if(GetPVarInt(i,"gPlayerAaction") == 0)
	  		{
	    		new string[145];
				format(string, sizeof(string), "Àäìèíèñòðàòîð %s çàáëîêèðîâàë %s íà 30 äíåé. Ïðè÷èíà: 3 ïðåäóïðåæäåíèÿ",PLAYER_DATA[playerid][data_NAME],PLAYER_DATA[params[0]][data_NAME]);
				SendClientMessage(i,COLOR_AC,string);
			}
		}
		return true;
	}
	return true;
}

