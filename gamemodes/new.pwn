		if(BUSINESS_DATA[b][data_OWNED] == 0)
		{
        	format(string,sizeof(string),"%s{FFFFFF}[%d] %s, êðûøà: %s, ñòîèìîñòü: {66FF33}%d ðóáëåé\n",string,b+1,BUSINESS_DATA[b][data_NAME],mafia,BUSINESS_DATA[b][data_PRICE]);
        }
