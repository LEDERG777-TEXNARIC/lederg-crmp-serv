CMD:mpskin(playerid,params[])
{
    if(antiflood[playerid] > 0) return SendClientMessage(playerid, COLOR_WARNING,"Íå ôëóäè!");
    antiflood[playerid]++;
    if(PLAYER_DATA[playerid][data_LOGGED] == false) return SendClientMessage(playerid,COLOR_WARNING,"Âû íå àâòîðèçîâàíû íà ñåðâåðå!");
    if(PLAYER_DATA[playerid][data_ADMLVL] < 4) return true;
	if(sscanf(params,"dd",params[0], params[1])) return SendClientMessage(playerid,COLOR_WARNING,"Èñïîëüçóéòå: /mpskin [1, 2, 3] [íîìåð ñêèíà]");
	if(params[1] > 297) return true;
	
	
	new team_1[250],team_2[250], all, team1, team2;
	new Float:x,Float:y,Float:z;
	GetPlayerPos(playerid, x,y,z);

   	
   	for(new i = 0; i < MAX_PLAYERS; i++)
	{
	    if(i == playerid) continue;
		if(!IsPlayerConnected(i)) continue;
		if(PlayerToPoint(100.0, i, x,y,z))
		{
		    all++;
            if(params[0] == 3)
			{
			    SetPlayerSkinAC(i,params[1]);
			    continue;
			}
            if(params[0] == 2 && all%2 == 0)
            {
                team2++;
            	team_2[team2] = i;
            	SetPlayerSkinAC(i,params[1]);
            	continue;
			}
			if(params[0] == 1 && all%2 == 1)
			{
			    team1++;
			    team_1[team1] = i;
			    SetPlayerSkinAC(i,params[1]);
			    continue;
			}
			if(params[0] < 1 || params[0] > 3)
			{
			    SendClientMessage(playerid, COLOR_WARNING,"Èñïîëüçóéòå: /mpskin [1, 2, 3] [íîìåð ñêèíà]");
			    break;
			}
		}
   	}
    return true;
}



CMD:mpgun(playerid,params[])
{
    if(antiflood[playerid] > 0) return SendClientMessage(playerid, COLOR_WARNING,"Íå ôëóäè!");
    antiflood[playerid]++;
	if(PLAYER_DATA[playerid][data_LOGGED] == false) return SendClientMessage(playerid,COLOR_WARNING,"Âû íå àâòîðèçîâàíû íà ñåðâåðå!");
    if(PLAYER_DATA[playerid][data_ADMLVL] < 4) return true;
	if(sscanf(params, "ddd", params[0], params[1], params[2])) return SendClientMessage(playerid, COLOR_WARNING, "Èñïîëüçóéòå: /mpgun [1, 2, 3] [îðóæèå] [ïàòðîíû]");
  	else if(params[1] > 47 || params[1] < 1) return SendClientMessage(playerid, COLOR_WARNING,"Òàêîãî îðóæèÿ íå ñóùåñòâóåò!");
    else if(params[2] > 1000 || params[2] < 1) return SendClientMessage(playerid, COLOR_WARNING,"Íå âåðíîå êîëè÷åñòâî ïàòðîí!");


	new team_1[250],team_2[250], all, team1, team2;
	new Float:x,Float:y,Float:z;
	GetPlayerPos(playerid, x,y,z);


   	for(new i = 0; i < MAX_PLAYERS; i++)
	{
	    if(i == playerid) continue;
		if(!IsPlayerConnected(i)) continue;
		if(PlayerToPoint(100.0, i, x,y,z))
		{
		    all++;
            if(params[0] == 3)
			{
			    GiveWeapon(i,params[1], params[2]);
			    continue;
			}
            if(params[0] == 2 && all%2 == 0)
            {
                team2++;
            	team_2[team2] = i;
            	GiveWeapon(i,params[1], params[2]);
            	continue;
			}
			if(params[0] == 1 && all%2 == 1)
			{
			    team1++;
			    team_1[team1] = i;
			    GiveWeapon(i,params[1], params[2]);
			    continue;
			}
			if(params[0] < 1 || params[0] > 3)
			{
			    SendClientMessage(playerid, COLOR_WARNING,"Èñïîëüçóéòå: /mpgun [1, 2, 3] [íîìåð ñêèíà]");
			    break;
			}
		}
   	}
   	
   	
   	
    return true;
}

CMD:gun(playerid,params[])
{
    if(antiflood[playerid] > 0) return SendClientMessage(playerid, COLOR_WARNING,"Íå ôëóäè!");
    antiflood[playerid]++;
	if(PLAYER_DATA[playerid][data_LOGGED] == false) return SendClientMessage(playerid,COLOR_WARNING,"Âû íå àâòîðèçîâàíû íà ñåðâåðå!");
    if(PLAYER_DATA[playerid][data_ADMLVL] < 4) return true;
	if(sscanf(params, "udd", params[0], params[1], params[2])) return SendClientMessage(playerid, COLOR_WARNING, "Èñïîëüçóéòå: /gun [èä] [îðóæèå] [ïàòðîíû]");
    if(!IsPlayerConnected(params[0]))return  SendClientMessage(playerid,COLOR_WARNING,"Äàííîãî ID íåò íà ñåðâåðå!");
	if(PLAYER_DATA[params[0]][data_LOGGED] == false)return  SendClientMessage(playerid,COLOR_WARNING,"Äàííûé èãðîê íå ïðîøåë àâòîðèçàöèþ!");
	else if(params[1] > 47 || params[1] < 1) return SendClientMessage(playerid, COLOR_WARNING,"Òàêîãî îðóæèÿ íå ñóùåñòâóåò!");
    else if(params[2] > 1000 || params[2] < 1) return SendClientMessage(playerid, COLOR_WARNING,"Íå âåðíîå êîëè÷åñòâî ïàòðîí!");
    GiveWeapon(params[0], params[1], params[2]);
    return true;
}

