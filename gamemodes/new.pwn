CMD:pay(playerid,params[])
{
    if(antiflood[playerid] > 0) return SendClientMessage(playerid, COLOR_WARNING,"Íå ôëóäè!");
    antiflood[playerid]++;
    if(PLAYER_DATA[playerid][data_LOGGED] == false) return SendClientMessage(playerid,COLOR_WARNING,"Âû íå àâòîðèçîâàíû íà ñåðâåðå!");
	if(PLAYER_DATA[playerid][data_LVL] < 2) return SendClientMessage(playerid,COLOR_WARNING,"Äàííóþ êîìàíäó ìîæíî èñïîëüçîâàòü òîëüêî ñî 2 óðîâíÿ!");
	if(sscanf(params, "ud", params[0],params[1])) return SendClientMessage(playerid, COLOR_WARNING, "Èñïîëüçóéòå: /pay [èä] [êîë-âî]");
	if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid,COLOR_WARNING,"Äàííîãî ID íåò íà ñåðâåðå!");
	if(PLAYER_DATA[params[0]][data_LOGGED] == false) return SendClientMessage(playerid,COLOR_WARNING,"Äàííûé èãðîê íå ïðîøåë àâòîðèçàöèþ!");
	if(playerid == params[0]) return SendClientMessage(playerid, COLOR_WARNING, "Íåëüçÿ!");
	new Float:x,Float:y,Float:z,str[145];
	GetPlayerPos(params[0],x,y,z);
	if(!PlayerToPoint(3.0, playerid, x,y,z)) return SendClientMessage(playerid,COLOR_WARNING,"Äàííûé èãðîê äàëåêî îò Âàñ!");
	if(params[1] <= 0) return SendClientMessage(playerid, COLOR_WARNING, "Íåäîïóñòèìîå çíà÷åíèå!");
	
	if(PLAYER_DATA[playerid][data_VIP] == 0)
	{
		if(params[1] > 5000) return SendClientMessage(playerid,COLOR_WARNING,"Ðàçðåøåíî ïåðåäàâàòü íå áîëåå 5000 ðóáëåé çà îäèí ðàç!");
	}
	else
	{
	    if(params[1] > 100000) return SendClientMessage(playerid,COLOR_WARNING,"Ðàçðåøåíî ïåðåäàâàòü íå áîëåå 5000 ðóáëåé çà îäèí ðàç!");
	}
	
	if(get_player_money(playerid) < params[1]) return SendClientMessage(playerid,COLOR_WARNING,"Ó Âàñ íåäîñòàòî÷íî äåíåã íà ðóêàõ!");
	give_player_money(playerid,-params[1],"#70");
	give_player_money(params[0],params[1],"#71");
	format(str,sizeof(str),"%s ïåðåäàë(à) äåíüãè %s",PLAYER_DATA[playerid][data_NAME], PLAYER_DATA[params[0]][data_NAME]);
    ProxDetector(30.0, playerid, str,0xDD90FFFF,0xDD90FFFF,0xDD90FFFF,0xDD90FFFF,0xDD90FFFF);
    SetPlayerChatBubble(playerid, "ïåðåäàë(à) äåíüãè", 0xDD90FFFF, 20.0, 4000);
    
    new logtext[64];
    format(logtext,sizeof(logtext),"ïåðåäàë %s %d ðóáëåé",PLAYER_DATA[params[0]][data_NAME],params[1]);
    LOG("log_paymoney",PLAYER_DATA[playerid][data_NAME], logtext);
	return true;
}


CMD:eject(playerid,params[])
{
    if(antiflood[playerid] > 0) return SendClientMessage(playerid, COLOR_WARNING,"Íå ôëóäè!");
    antiflood[playerid]++;
    if(PLAYER_DATA[playerid][data_LOGGED] == false) return SendClientMessage(playerid,COLOR_WARNING,"Âû íå àâòîðèçîâàíû íà ñåðâåðå!");
	if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return SendClientMessage(playerid,COLOR_WARNING,"Âû íå çà ðóëåì!");
	if(sscanf(params,"d",params[0])) return SendClientMessage(playerid,COLOR_WARNING,"Èñïîëüçóéòå: /eject [èä]");
	if(!IsPlayerConnected(params[0]))return  SendClientMessage(playerid,COLOR_WARNING,"Äàííîãî ID íåò íà ñåðâåðå!");
	if(PLAYER_DATA[params[0]][data_LOGGED] == false)return  SendClientMessage(playerid,COLOR_WARNING,"Äàííûé èãðîê íå ïðîøåë àâòîðèçàöèþ!");
	if(params[0] == playerid) return SendClientMessage(playerid,COLOR_WARNING,"Âû íå ìîæåòå âûêèíóòü èç ìàøèíû ñàìîãî ñåáÿ!");
    new car = GetPlayerVehicleID(playerid);
	new idcar = GetPlayerVehicleID(params[0]);
	if(!IsPlayerInVehicle(playerid,car)) return true;
	if(car != idcar) return SendClientMessage(playerid,COLOR_WARNING,"Äàííûé èãðîê íå íàõîäèòüñÿ â Âàøåé ìàøèíå!");
	RemovePlayerFromVehicleAC(params[0]);
	new message[145];
	format(message,sizeof(message),"%s áûë âûáðîøåí èç àâòîìîáèëÿ",PLAYER_DATA[params[0]][data_NAME]);
	SendClientMessage(playerid,0xFF9999FF,message);
	SendClientMessage(params[0],0xFF9999FF,"Âàñ âûáðîñèëè èç àâòîìîáèëÿ");
	return true;
}

