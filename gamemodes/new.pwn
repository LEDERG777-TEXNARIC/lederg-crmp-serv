	SendClientMessage(playerid, 0xFF9999FF, str1);
	format(str2,sizeof(str2),"%s ïðåäëîæèë Âàì ïîæàòü ðóêó. Äëÿ ñîãëàñèÿ {31B404}Y{FF9999}, äëÿ îòêàçà íàæìèòå {FE2E2E}N",PLAYER_DATA[playerid][data_NAME]);
	SendClientMessage(params[0], 0xFF9999FF, str2);
		
		
		

	return true;
}


CMD:time(playerid)
{
    if(antiflood[playerid] > 0) return SendClientMessage(playerid, COLOR_WARNING,"Íå ôëóäè!");
    antiflood[playerid]++;
	if(PLAYER_DATA[playerid][data_LOGGED] == false) return SendClientMessage(playerid,COLOR_WARNING,"Âû íå àâòîðèçîâàíû íà ñåðâåðå!");
	if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT) ApplyAnimation(playerid,"COP_AMBIENT","Coplook_watch",4.1,0,0,0,0,0);
  	new hour,minuite,string[36],str[21+MAX_PLAYER_NAME],Year, Month, Day,month[10];
  	gettime(hour,minuite);
	getdate(Year, Month, Day);
	switch(Month)
	{
		case 1: month = "01";
		case 2: month = "02";
		case 3: month = "03";
		case 4: month = "04";
		case 5: month = "05";
		case 6: month = "06";
		case 7: month = "07";
		case 8: month = "08";
		case 9: month = "09";
		case 10: month = "10";
		case 11: month = "11";
		case 12: month = "12";
	}
	if(PLAYER_DATA[playerid][data_JAIL] != 0)
	{
		format(string,sizeof(string),"~y~%02d:%02d~n~~b~%d.%s.%d~n~~g~Jail: %d",hour,minuite,Day, month,Year,PLAYER_DATA[playerid][data_JAILTIME]);
	}
	else
	{
		format(string,sizeof(string),"~y~%02d:%02d~n~~b~%d.%s.%d",hour,minuite,Day, month,Year);
	}
	GameTextForPlayer(playerid, string, 5000, 1);
	format(str,sizeof(str),"%s âçãëÿíóë(à) íà ÷àñû",PLAYER_DATA[playerid][data_NAME]);
    ProxDetector(30.0, playerid, str,0xDD90FFFF,0xDD90FFFF,0xDD90FFFF,0xDD90FFFF,0xDD90FFFF);
    SetPlayerChatBubble(playerid, "âçãëÿíóë(à) íà ÷àñû", 0xDD90FFFF, 20.0, 4000);
	switch(PLAYER_DATA[playerid][data_MEMBER])
	{
		case 5,6,7: SendClientMessage(playerid,0x04B431FF,"ÇÀÕÂÀÒ: 01:00, 03:00, 05:00, 07:00, 09:00, 11:00, 13:00, 15:00, 17:00, 19:00, 21:00, 23:00");
	}
	return true;
}



