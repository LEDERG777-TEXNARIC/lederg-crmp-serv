stock UpdateKVData(kv, k)
{
	DestroyDynamic3DTextLabel(KV_DATA[kv][data_INFO][k]);
    new owner[MAX_PLAYER_NAME], class_kv[8],str[256];
	switch(k)
	{
		case 0: strmid(owner, KV_DATA[kv][data_OWNER_1], 0, strlen(KV_DATA[kv][data_OWNER_1]), MAX_PLAYER_NAME);
		case 1: strmid(owner, KV_DATA[kv][data_OWNER_2], 0, strlen(KV_DATA[kv][data_OWNER_2]), MAX_PLAYER_NAME);
		case 2: strmid(owner, KV_DATA[kv][data_OWNER_3], 0, strlen(KV_DATA[kv][data_OWNER_3]), MAX_PLAYER_NAME);
		case 3: strmid(owner, KV_DATA[kv][data_OWNER_4], 0, strlen(KV_DATA[kv][data_OWNER_4]), MAX_PLAYER_NAME);
		case 4: strmid(owner, KV_DATA[kv][data_OWNER_5], 0, strlen(KV_DATA[kv][data_OWNER_5]), MAX_PLAYER_NAME);
		case 5: strmid(owner, KV_DATA[kv][data_OWNER_6], 0, strlen(KV_DATA[kv][data_OWNER_6]), MAX_PLAYER_NAME);
	}

	switch(KV_DATA[kv][data_CLASS][k])
	{
		case 0: class_kv = "Ýêîíîì";
		case 1: class_kv = "Ñðåäíèé";
		case 2: class_kv = "Ýëèòíûé";
	}

	if(KV_DATA[kv][data_OWNED][k] == 0)
	{
		format(str,sizeof(str), "{66FF66}Êâàðòèðà ¹%d\n{6699CC}Êëàññ: {FFFFFF}%s\n{6699CC}Ñòîèìîñòü: {FFFFFF}%d ðóáëåé\n{FFCC00}Äëÿ ïîêóïêè èñïîëüçóéòå: /buy",k+1, class_kv, KV_DATA[kv][data_PRICE][k]);
		KV_DATA[kv][data_INFO][k] = CreateDynamic3DTextLabel(str, -1, KV_DATA[kv][data_ENTER_POSX][k], KV_DATA[kv][data_ENTER_POSY][k], KV_DATA[kv][data_ENTER_POSZ][k], 5.0,INVALID_PLAYER_ID,INVALID_VEHICLE_ID,0,KV_DATA[kv][data_ID]);
	}
	else
	{
		format(str,sizeof(str), "{66FF66}Êâàðòèðà ¹%d\n{6699CC}Êëàññ: {FFFFFF}%s\n{6699CC}Âëàäåëåö: {FFFFFF}%s",k+1, class_kv, owner);
		KV_DATA[kv][data_INFO][k] = CreateDynamic3DTextLabel(str, -1, KV_DATA[kv][data_ENTER_POSX][k], KV_DATA[kv][data_ENTER_POSY][k], KV_DATA[kv][data_ENTER_POSZ][k], 5.0,INVALID_PLAYER_ID,INVALID_VEHICLE_ID,0,KV_DATA[kv][data_ID]);
	}

	new kk;
	for(new kq = 0; kq < 6; kq++)
	{
		if(KV_DATA[kv][data_OWNED][kq] == 0)
		{}
		else kk++;
	}
	if(kk == 6)
	{
	    DestroyDynamicMapIcon(KV_DATA[kv][data_MAPICON]);
		KV_DATA[kv][data_MAPICON] = CreateDynamicMapIcon(KV_DATA[kv][data_ENTER_X], KV_DATA[kv][data_ENTER_Y], KV_DATA[kv][data_ENTER_Z], 32, -1, 0, -1, -1, 100.0);
	}
	else
	{
	    DestroyDynamicMapIcon(KV_DATA[kv][data_MAPICON]);
		KV_DATA[kv][data_MAPICON] = CreateDynamicMapIcon(KV_DATA[kv][data_ENTER_X], KV_DATA[kv][data_ENTER_Y], KV_DATA[kv][data_ENTER_Z], 31, -1, 0, -1, -1, 100.0);
	}
	return true;
}

stock GetCoordBootVehicle(vehicleid, &Float:x, &Float:y, &Float:z)
{
	new Float:angle,Float:distance;
	GetVehicleModelInfo(GetVehicleModel(vehicleid), 1, x, distance, z);
	distance = distance/2 + 0.1;
	GetVehiclePos(vehicleid, x, y, z);
	GetVehicleZAngle(vehicleid, angle);
	x += (distance * floatsin(-angle+180, degrees));
	y += (distance * floatcos(-angle+180, degrees));
	return true;
}

stock RemovePlayerFromVehicleAC(playerid)
{
    GetPlayerPos(playerid,oldposX[playerid],oldposY[playerid],oldposZ[playerid]);
	return RemovePlayerFromVehicle(playerid);
}

stock SetPlayerSkinAC(playerid, skinid)
{
	ClearAnimations(playerid);
	SetPlayerSkin(playerid, skinid);
	return true;
}


stock SetPlayerPosAC(playerid,Float:x,Float:y,Float:z)
{
	oldposX[playerid] = x;
	oldposY[playerid] = y;
	oldposZ[playerid] = z;
	DeletePVar(playerid, "ac_fly");
	SetPlayerPos(playerid,oldposX[playerid],oldposY[playerid],oldposZ[playerid]);
	return true;
}

stock PutPlayerInVehicleAC(playerid,car,set)
{
    DeletePVar(playerid, "ac_fly");
	PutPlayerInVehicle(playerid,car,set);
	return true;
}


stock OnPlayerAmmoChange(playerid, newammo, oldammo)
{
    if(newammo < oldammo)
    {
        switch(GetPlayerWeapon(playerid))
        {
            case 24:
            {
                SetPVarInt(playerid, "SkillD",GetPVarInt(playerid,"SkillD") +1);
                if(GetPVarInt(playerid,"SkillD") >= Ammo_DEAGLE && PLAYER_DATA[playerid][data_DEAGLE] < 100)
                {
                    PLAYER_DATA[playerid][data_DEAGLE]++;
                    SetPVarInt(playerid, "SkillD",0);
                }
            }
            case 22:
            {
                SetPVarInt(playerid, "SkillP",GetPVarInt(playerid,"SkillP") +1);
                if(GetPVarInt(playerid,"SkillP")>= Ammo_PISTOL && PLAYER_DATA[playerid][data_PISTOL] < 100)
                {
                     PLAYER_DATA[playerid][data_PISTOL]++;
                     SetPVarInt(playerid, "SkillP",0);
                }
            }
            case 23:
            {
                SetPVarInt(playerid, "SkillSD",GetPVarInt(playerid,"SkillSD") +1);
                if(GetPVarInt(playerid,"SkillSD")>= Ammo_SDPISTOL && PLAYER_DATA[playerid][data_SDPISTOL] < 100)
                {
                     PLAYER_DATA[playerid][data_SDPISTOL]++;
                     SetPVarInt(playerid, "SkillSD",0);
                }
            }
            case 25:
            {
                SetPVarInt(playerid, "SkillShot",GetPVarInt(playerid,"SkillShot") +1);
                if(GetPVarInt(playerid,"SkillShot") >= Ammo_SHOTGUN && PLAYER_DATA[playerid][data_SHOTGUN] < 100)
                {
                    PLAYER_DATA[playerid][data_SHOTGUN]++;
                    SetPVarInt(playerid, "SkillShot",0);
                }
            }
            case 29:
            {
                SetPVarInt(playerid, "SkillMP5",GetPVarInt(playerid,"SkillMP5") +1);
                if(GetPVarInt(playerid,"SkillMP5") >= Ammo_MP5 && PLAYER_DATA[playerid][data_MP5] < 100)
                {
                    PLAYER_DATA[playerid][data_MP5]++;
                    SetPVarInt(playerid, "SkillMP5",0);
                }
            }
            case 30:
            {
                SetPVarInt(playerid, "SkillAk47",GetPVarInt(playerid,"SkillAk47") +1);
                if(GetPVarInt(playerid,"SkillAk47") >= Ammo_AK47 && PLAYER_DATA[playerid][data_AK47] < 100)
                {
                    PLAYER_DATA[playerid][data_AK47]++;
                    SetPVarInt(playerid, "SkillAk47",0);
                }
            }
            case 34:
            {
                SetPVarInt(playerid, "SkillRifle",GetPVarInt(playerid,"SkillRifle") +1);
                if(GetPVarInt(playerid,"SkillRifle") >= Ammo_RIFLE && PLAYER_DATA[playerid][data_SNIPERRIFLE] < 100)
                {
                    PLAYER_DATA[playerid][data_SNIPERRIFLE]++;
                    SetPVarInt(playerid, "SkillRifle",0);
                }
            }
        }
    }
    return true;
}


stock ReportDialog(playerid)
{
	new dtext[700];
	strcat(dtext, "{FFFFFF}Âû ñîáèðàåòåñü íàïèñàòü Àäìèíèñòðàöèè ñåðâåðà\n");
	strcat(dtext, "{FFFFFF}Ïåðåä òåì êàê îòïðàâèòü ñîîáùåíèå\n");
	strcat(dtext, "{FFFFFF}óáåäèòåñü, ÷òî îäèí èç ïóíêòîâ ïîìîùè íå äàë Âàì îòâåòà íà Âàø âîïðîñ\n\n");
	strcat(dtext, "{FF3300}Çàïðåùåíî:\n");
	strcat(dtext, "{FFFFFF}- ôëóä, ñêâåðíîñëîâèå, îôôòîï\n");
	strcat(dtext, "{FFFFFF}- Âûïðàøèâàíèå èãðîâûõ öåííîñòåé ('äàòü äåíåã', 'äàòü ëèäåðêó', 'äàòü ïðàâà')\n");
	strcat(dtext, "{FFFFFF}- ëîæíûå ñîîáùåíèÿ î íàðóøåíèè\n\n");
	strcat(dtext, "{FF3300}Çà íàðóøåíèå ïðàâèë Àäìèíèñòðàòîð ìîæåò:\n");
	strcat(dtext, "{FFFFFF}- ïðåäóïðåäèòü (warn)\n");
	strcat(dtext, "{FFFFFF}- îòêëþ÷èòü îò ñåðâåðà (kick)\n");
	strcat(dtext, "{FFFFFF}- ëèøèòü âîçìîæíîñòè ïèñàòü (mute)\n");
	strcat(dtext, "{FFFFFF}- çàáëîêèðîâàòü (ban)\n\n");
	strcat(dtext, "{FFFFFF}Äàííûå ïðàâèëà óñòàíîâëåíû äëÿ âñåõ èãðîêîâ {339966}LEDERG PROJECT");
	ShowPlayerDialogFix(playerid,dialog_REPORT,DIALOG_STYLE_INPUT,"{FFCC00}Ðåïîðò",dtext,"Îòïðàâèòü","Íàçàä");
	return true;
}

stock RulesDialog(playerid)
{
	new dtext[2300];
	strcat(dtext, "{33FF33}« Èãðîâîé ïðîöåññ »\n");
	strcat(dtext, "{FF3300}Çàïðåùåíî:\n");
	strcat(dtext, "{FFFFFF}- èñïîëüçîâàíèå ëþáûõ ïðîãðàìì, ñêðèïòîâ, ÷èòîâ è ò.ï. äàþùèå ïðåèìóùåñòâî â èãðå\n");
	strcat(dtext, "{FFFFFF}- èñïîëüçîâàíèå áàãîâ (îøèáîê, íåèñïðàâíîñòåé ìîäà)\n");
	strcat(dtext, "{FFFFFF}- èñïîëüçîâàòü ESC â öåëÿõ óõîäà îò ïîãîíè/ñìåðòè\n");
	strcat(dtext, "{FFFFFF}- óáèâàòü èãðîêîâ íà ñïàâíå (ìåñòî âîçðîæäåíèÿ, áàçà îðãàíèçàöèè)\n");
	strcat(dtext, "{FFFFFF}- óáèâàòü èãðîêîâ ïðè ïîìîùè òðàíñïîðòà (äàâèòü)\n");
	strcat(dtext, "{FFFFFF}- óáèéñòâî/íàíåñåíèå óðîíà èãðîêàì áåç ïðè÷èíû (DM - Death Match)\n");
	strcat(dtext, "{FFFFFF}- çëîóïîòðåáëåíèå èãðîÂûìè âîçìîæíîñòÿìè äëÿ ñîçäàíèÿ íåóäîáñòâ èãðîêàì\n\n");
	strcat(dtext, "{33FF33}« Íèê â èãðå »\n");
	strcat(dtext, "{FFFFFF}- íèê äîëæåí ñîñòîÿòü èç Èìåíè_Ôàìèëèè ñ çàãëàâíûõ áóêâ\n");
	strcat(dtext, "{FFFFFF}- çàïðåùåíî èñïîëüçîâàòü ÷óæèå (óæå êåì-òî çàíÿòûå íèêè)\n");
	strcat(dtext, "{FFFFFF}- çàïðåùåíî èñïîëüçîâàòü íèêè, ñîäåðæàùèå îñêîðáèòåëüíûå è íåöåíçóðíûå ñëîâà\n\n");
	strcat(dtext, "{33FF33}« ×àò ñåðâåðà »\n");
	strcat(dtext, "{FF3300}Çàïðåùåíî:\n");
	strcat(dtext, "{FFFFFF}- ðóãàòåëüñòâî, îñêîðáëåíèÿ èëè íåöåíçóðíàÿ ðå÷ü â OOC ÷àò\n");
	strcat(dtext, "{FFFFFF}- óãðîçû èãðîêàì â OOC ÷àò\n");
	strcat(dtext, "{FFFFFF}- ïèñàòü ñîîáùåíèÿ â âåðõíåì ðåãèñòðå (Caps Lock)\n");
	strcat(dtext, "{FFFFFF}- ïèñàòü â îáû÷íûé ÷àò ñîîáùåíèÿ íå îòíîñÿùèåñÿ ê IC\n");
	strcat(dtext, "{FFFFFF}- èñïîëüçîâàíèå OOC èíôîðìàöèè â IC (MåtaGàming)\n");
	strcat(dtext, "{FFFFFF}- ïèñàòü îäíî è òîæå ñîîáùåíèå ñëèøêîì ÷àñòî\n");
	strcat(dtext, "{FFFFFF}- ðåêëàìà ñòîðîííèõ ðåñóðñîâ\n\n");
	strcat(dtext, "{33FF33}« Àäìèíèñòðàöèÿ ñåðâåðà »\n");
