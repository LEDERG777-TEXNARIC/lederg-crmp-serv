	if(sscanf(params,"s[80]",params[0])) return SendClientMessage(playerid,COLOR_WARNING,"Èñïîëüçóéòå: /try [òåêñò]");
    NotReklama(playerid, params[0]);
	new string[145];
    switch(random(2))
    {
		case 0: format(string, sizeof(string), "%s %s | {26A65B}óäà÷íî",PLAYER_DATA[playerid][data_NAME],params[0]);
    	case 1: format(string, sizeof(string), "%s  %s | {EF4836}íåóäà÷íî",PLAYER_DATA[playerid][data_NAME],params[0]);
	}
	ProxDetector(30.0, playerid, string, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF);
	return true;
}

