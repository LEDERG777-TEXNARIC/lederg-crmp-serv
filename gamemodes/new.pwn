CMD:invite(playerid,params[])
{
    if(antiflood[playerid] > 0) return SendClientMessage(playerid, COLOR_WARNING,"Íå ôëóäè!");
    antiflood[playerid]++;
    if(PLAYER_DATA[playerid][data_LOGGED] == false) return SendClientMessage(playerid,COLOR_WARNING,"Âû íå àâòîðèçîâàíû íà ñåðâåðå!");
	
	switch(PLAYER_DATA[playerid][data_MEMBER])
	{
		case 1:
		{
		    if(PLAYER_DATA[playerid][data_RANK] < 6) return SendClientMessage(playerid, COLOR_WARNING, "Âàì íåäîñòóïíà äàííàÿ êîìàíäà!");
		}
		case 2:
		{
		    if(PLAYER_DATA[playerid][data_RANK] < 13) return SendClientMessage(playerid, COLOR_WARNING, "Âàì íåäîñòóïíà äàííàÿ êîìàíäà!");
		}
		case 3:
		{
		    if(PLAYER_DATA[playerid][data_RANK] < 14) return SendClientMessage(playerid, COLOR_WARNING, "Âàì íåäîñòóïíà äàííàÿ êîìàíäà!");
		}
		case 4:
		{
		    if(PLAYER_DATA[playerid][data_RANK] < 5) return SendClientMessage(playerid, COLOR_WARNING, "Âàì íåäîñòóïíà äàííàÿ êîìàíäà!");
		}
		case 5,6,7:
		{
		    if(PLAYER_DATA[playerid][data_RANK] < 6) return SendClientMessage(playerid, COLOR_WARNING, "Âàì íåäîñòóïíà äàííàÿ êîìàíäà!");
		}
		case 8:
		{
		    if(PLAYER_DATA[playerid][data_RANK] < 13) return SendClientMessage(playerid, COLOR_WARNING, "Âàì íåäîñòóïíà äàííàÿ êîìàíäà!");
		}
		case 9:
		{
		    if(PLAYER_DATA[playerid][data_RANK] < 6) return SendClientMessage(playerid, COLOR_WARNING, "Âàì íåäîñòóïíà äàííàÿ êîìàíäà!");
		}
		default: return SendClientMessage(playerid, COLOR_WARNING, "Âàì íåäîñòóïíà äàííàÿ êîìàíäà!");

	}
	
	
	if(sscanf(params,"u",params[0])) return SendClientMessage(playerid,COLOR_WARNING,"Èñïîëüçóéòå: /invite [èä]");
	if(params[0] == playerid) return SendClientMessage(playerid,COLOR_WARNING,"Íåëüçÿ èñïîëüçîâàòü íà ñàìîì ñåáå!");
	if(!IsPlayerConnected(params[0]))return  SendClientMessage(playerid,COLOR_WARNING,"Äàííîãî ID íåò íà ñåðâåðå!");
	if(PLAYER_DATA[params[0]][data_LOGGED] == false)return  SendClientMessage(playerid,COLOR_WARNING,"Äàííûé èãðîê íå ïðîøåë àâòîðèçàöèþ!");
	if(PLAYER_DATA[params[0]][data_MEMBER] != 0) return  SendClientMessage(playerid,COLOR_WARNING,"Äàííûé èãðîê ñîñòîèò âî îðãàíèçàöèè!");
	if(PLAYER_DATA[params[0]][data_WARN] != 0) return SendClientMessage(playerid,COLOR_WARNING,"Ó äàííîãî èãðîêà åñòü ïðåäóïðåæäåíèÿ!");
	new Float:x,Float:y,Float:z;
	GetPlayerPos(params[0],x,y,z);
	if(!PlayerToPoint(5.0, playerid, x,y,z)) return SendClientMessage(playerid,COLOR_WARNING,"Äàííûé èãðîê ñëèøêîì äàëåêî îò Âàñ!");


	SetPVarInt(params[0], "yesno_invite", 1);
	SetPVarInt(params[0], "yesno_playerid", playerid);
	SetPVarInt(params[0], "yesno", 1);
	new str1[145], str2[145];
	format(str1,sizeof(str1),"Âû ïðåäëîæèëè ïðèñîåäèíèòüñÿ ê âàøåé îðãàíèçàöèè %s",PLAYER_DATA[params[0]][data_NAME]);
	SendClientMessage(playerid, 0xDD90FFFF, str1);
	format(str2,sizeof(str2),"%s ïðåäëîæèë Âàì ïðèñîåäåíèòüñÿ ê åãî îðãàíèçàöèè. Äëÿ ñîãëàñèÿ {31B404}Y{FF66CC}, äëÿ îòêàçà íàæìèòå {FE2E2E}N",PLAYER_DATA[playerid][data_NAME]);
	SendClientMessage(params[0], 0xDD90FFFF, str2);
	return true;
}


CMD:leave(playerid,params[])
{
    if(antiflood[playerid] > 0) return SendClientMessage(playerid, COLOR_WARNING,"Íå ôëóäè!");
    antiflood[playerid]++;
    if(PLAYER_DATA[playerid][data_LOGGED] == false) return SendClientMessage(playerid,COLOR_WARNING,"Âû íå àâòîðèçîâàíû íà ñåðâåðå!");
    if(PLAYER_DATA[playerid][data_VIP] != 1) return SendClientMessage(playerid, COLOR_WARNING, "Äàííàÿ ôóíêöèÿ äîñòóïíà òîëüêî VIP èãðîêàì!");
	if(PLAYER_DATA[playerid][data_MEMBER] == 0) return SendClientMessage(playerid, COLOR_WARNING, "Âû íå ñîñòîèòå â îðãàíèçàöèè!");

	new str[145];
	format(str,sizeof(str),"[F] %s âûøåë èç îðãàíèçàöèè",PLAYER_DATA[playerid][data_NAME]);
	SendFractionMessage(PLAYER_DATA[playerid][data_MEMBER], 0xFF3333FF, str);
	PLAYER_DATA[playerid][data_MEMBER] = 0;
	PLAYER_DATA[playerid][data_PODMEMBER] = 0;
	PLAYER_DATA[playerid][data_RANK] = 0;
	PLAYER_DATA[playerid][data_LEADER] = 0;
	SetPlayerSkinAC(playerid,PLAYER_DATA[playerid][data_SKIN]);
	SetPlayerColorEx(playerid);

	if(IsPlayerInAnyVehicle(playerid) && GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
	{
		new Float:x, Float:y, Float:z;
	 	GetPlayerPos(playerid,x,y,z);
	 	SetPlayerPosAC(playerid,x,y,z+2);
	}
	return true;
}



