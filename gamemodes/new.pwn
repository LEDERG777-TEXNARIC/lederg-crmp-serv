			    SetCameraBehindPlayer(playerid);
			    FreezePlayer(playerid);
				SetTimerEx("UnfreezePlayer", 4000, false, "d", playerid);
				
				new message[45];
				format(message,sizeof(message),"Âàøà êâàðòèðà îïëà÷åíà íà %d äíÿ/äíåé",KV_DATA[kv][data_DAY][k]);
				SendClientMessage(playerid,0xFFCC00FF,message);
