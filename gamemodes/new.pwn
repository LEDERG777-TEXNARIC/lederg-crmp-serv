public OnPlayerSelectedMenuRow(playerid, row)
{
    if(GetPlayerMenu(playerid) == SelectSkin)
  	{
   		switch(row)
     	{
      		case 0:
      		{
      		    if(PLAYER_DATA[playerid][data_SEX] == 1)
		  		{
					PLAYER_DATA[playerid][data_CHANGESKIN]++;
		 			if(PLAYER_DATA[playerid][data_CHANGESKIN] >= 5) PLAYER_DATA[playerid][data_CHANGESKIN] = 0;
					SetPlayerSkinAC(playerid, PedMale[PLAYER_DATA[playerid][data_CHANGESKIN]]);
		 		}
		  		else
		        {
					PLAYER_DATA[playerid][data_CHANGESKIN]++;
		 			if(PLAYER_DATA[playerid][data_CHANGESKIN] >= 6) PLAYER_DATA[playerid][data_CHANGESKIN] = 0;
					SetPlayerSkinAC(playerid, PedFeMale[PLAYER_DATA[playerid][data_CHANGESKIN]]);
		 		}
                ShowMenuForPlayer(SelectSkin, playerid);
            }
            case 1:
            {
            	if(PLAYER_DATA[playerid][data_SEX] == 1)
		       	{
		  			PLAYER_DATA[playerid][data_CHANGESKIN]--;
		  			if(PLAYER_DATA[playerid][data_CHANGESKIN] <= -1) PLAYER_DATA[playerid][data_CHANGESKIN] = 4;
		            SetPlayerSkinAC(playerid, PedMale[PLAYER_DATA[playerid][data_CHANGESKIN]]);
				}
				else
		     	{
		    		PLAYER_DATA[playerid][data_CHANGESKIN]--;
			     	if(PLAYER_DATA[playerid][data_CHANGESKIN] <= -1) PLAYER_DATA[playerid][data_CHANGESKIN] = 5;
			 		SetPlayerSkinAC(playerid, PedFeMale[PLAYER_DATA[playerid][data_CHANGESKIN]]);
		      	}
                ShowMenuForPlayer(SelectSkin, playerid);
            }
            case 2:
            {
                if(GetPVarInt(playerid,"select_skin") == 0) return Kick(playerid);
                DeletePVar(playerid,"select_skin");
                PLAYER_DATA[playerid][data_SKIN] = GetPlayerSkin(playerid);
                PLAYER_DATA[playerid][data_LVL] = 1;
                PLAYER_DATA[playerid][data_ZAKON] = 100;
                PLAYER_DATA[playerid][data_LOGGED] = true;
                TogglePlayerControllable(playerid, true);
                DeletePVar(playerid,"player_auth");
                for(new x; x <30; x++) SendClientMessage(playerid, -1, " ");
                SendClientMessage(playerid, 0xFF9999FF, "Äîáðî ïîæàëîâàòü íà ñåðâåð ñ ðåæèìîì RolePlay. Ïîäðîáíî î ðåæèìå Âû ìîæåòå óçíàòü íà íàøåì ñàéòå: LEDERG PROJECT");
                SendClientMessage(playerid, 0xFF9999FF, "Åñëè Âû íîâè÷åê, òî îáÿçàòåëüíî ïðî÷èòàéòå ïîìîùü íà ñïàâíå (ìåñòî ãäå Âû ïîÿâëÿåòåñü â èãðå)");
                SendClientMessage(playerid, 0xFF9999FF, "Ïî ëþáîìó âîïðîñó, Âû ìîæåòå îáðàòèòüñÿ ê Àäìèíèñòðàöèè ñåðâåðà ñ ïîìîùüþ êîìàíäû /mm > ðåïîðò");
                SendClientMessage(playerid, 0xFF9999FF, "Äëÿ òîãî, ÷òîáû ââåñòè êîìàíäó íàæìèòå êëàâèøó F6 èëè àíãëèéñêóþ T (âñå êîìàíäû íà÷èíàþòñÿ ñ ñèìâîëà '/')");
                SendClientMessage(playerid, 0xFF9999FF, "Íóæíûå Âàì êîìàíäû Âû ìîæåòå ïîñìîòðåòü ñ ïîìîùüþ êîìàíäû /mn > ñïèñîê êîìàíä");
				CreateAccount(playerid);
				SetPlayerSpawn(playerid);
		    }
        }
    }
	return true;
}

