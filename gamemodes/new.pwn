CMD:capture(playerid)
{
    if(antiflood[playerid] > 0) return SendClientMessage(playerid, COLOR_WARNING,"Íå ôëóäè!");
    antiflood[playerid]++;
    if(PLAYER_DATA[playerid][data_LOGGED] == false) return SendClientMessage(playerid,COLOR_WARNING,"Âû íå àâòîðèçîâàíû íà ñåðâåðå!");
    if(PLAYER_DATA[playerid][data_MEMBER] == 5
	|| PLAYER_DATA[playerid][data_MEMBER] == 6
	|| PLAYER_DATA[playerid][data_MEMBER] == 7)
	{
		if(PLAYER_DATA[playerid][data_RANK] < 6) return SendClientMessage(playerid,COLOR_WARNING,"Âàì íåäîñòóïíà äàííàÿ êîìàíäà!");
		{
			for(new b = 0; b < TotalBusiness; b++)
			{
			    if(PlayerToPoint(10.0, playerid, BUSINESS_DATA[b][data_ENTERX],BUSINESS_DATA[b][data_ENTERY],BUSINESS_DATA[b][data_ENTERZ]) && BUSINESS_DATA[b][data_TYPE] != 1 ||
				PlayerToPoint(10.0, playerid, BUSINESS_DATA[b][data_BUYX],BUSINESS_DATA[b][data_BUYY],BUSINESS_DATA[b][data_BUYZ]) && BUSINESS_DATA[b][data_TYPE] == 1)
		  		{
					if(BUSINESS_DATA[b][data_MAFIA] == 0)
					{
				  		BUSINESS_DATA[b][data_MAFIA] = PLAYER_DATA[playerid][data_MEMBER];
						SendFractionMessage(PLAYER_DATA[playerid][data_MEMBER],COLOR_AC,"[F] Âàøà ãðóïïèðîâêà çàõâàòèëà íîâûé áèçíåñ!");
						SaveBusinessData(b);
						return true;
					}
		  			if(BUSINESS_DATA[b][data_MAFIA] == PLAYER_DATA[playerid][data_MEMBER]) return SendClientMessage(playerid, COLOR_WARNING,"Äàííûé áèçíåñ óæå ïðåíàäëåæèò âàøåé ãðóïïèðîâêå!");
					if(IsCapture == true) return SendClientMessage(playerid, COLOR_WARNING,"Â äàííûé ìîìåíò ïðîèñõîäèò çàõâàò áèçíåñà. Äîæäèòåñü îêîí÷àíèÿ çàõâàòà!");
					capt_time = 600;
					capt_one_team = PLAYER_DATA[playerid][data_MEMBER];
					capt_two_team = BUSINESS_DATA[b][data_MAFIA];
					capt_one_kill = 0;
					capt_two_kill = 0;
					capt_biz = b;
					IsCapture = true;
			 		CaptureStart(capt_one_team,capt_two_team);
					return true;
				}
			}
		}
	}

	return true;
}

