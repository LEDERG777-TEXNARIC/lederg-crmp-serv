	new string[145];
	new gun = GetPlayerWeapon(playerid);
	new gunslot = getWeaponIdSlot(gun);
    
    
	if(params[1] < 1) return SendClientMessage(playerid, COLOR_WARNING, "Íåäîïóñòèìîå çíà÷åíèå!");
	if(PLAYER_DATA[playerid][data_GUN][gunslot] == 0 || gunslot == 0) return SendClientMessage(playerid,COLOR_WARNING,"×òîáû ïåðåäàòü îðóæèå, íóæíî âçÿòü åãî â ðóêè!");
	if(PLAYER_DATA[playerid][data_AMMO][gunslot] < params[1]) return SendClientMessage(playerid,COLOR_WARNING, "Ó Âàñ íåò òàêîãî êîëè÷åñòâà ïàòðîíîâ!");


	new ammonew = PLAYER_DATA[playerid][data_AMMO][gunslot] - params[1];

	SetWeapon(playerid, gun, ammonew);
    GiveWeapon(params[0], gun, params[1]);



    format(string, sizeof(string), "%s ïåðåäàë(à) îðóæèå %s",PLAYER_DATA[playerid][data_NAME],PLAYER_DATA[params[0]][data_NAME]);
	ProxDetector(30.0, playerid, string, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF);
	SetPlayerChatBubble(playerid, "ïåðåäàë(à) îðóæèå", 0xDD90FFFF, 20.0, 4000);
	return true;
}

