CMD:su(playerid,params[])
{
    if(antiflood[playerid] > 0) return SendClientMessage(playerid, COLOR_WARNING,"Íå ôëóäè!");
    antiflood[playerid]++;
    if(PLAYER_DATA[playerid][data_LOGGED] == false) return SendClientMessage(playerid,COLOR_WARNING,"Âû íå àâòîðèçîâàíû íà ñåðâåðå!");
    if(!IsPlayerCops(playerid)) return SendClientMessage(playerid,COLOR_WARNING,"Âàì íåäîñòóïíà äàííàÿ êîìàíäà!");
    if(sscanf(params, "us[50]", params[0], params[1])) return SendClientMessage(playerid,COLOR_WARNING,"Èñïîëüçóéòå: /su [èä] [ïðè÷èíà]");
    if(!IsPlayerConnected(params[0]))return  SendClientMessage(playerid,COLOR_WARNING,"Äàííîãî ID íåò íà ñåðâåðå!");
	if(PLAYER_DATA[params[0]][data_LOGGED] == false)return  SendClientMessage(playerid,COLOR_WARNING,"Äàííûé èãðîê íå ïðîøåë àâòîðèçàöèþ!");
	if(PLAYER_DATA[playerid][data_RANK] < 2 && PLAYER_DATA[playerid][data_MEMBER] != 8) return SendClientMessage(playerid,COLOR_WARNING,"Âàø ðàíã ñëèøêîì ìàë äëÿ èñïîëüçîâàíèÿ äàííîé êîìàíäû!");
