CMD:pm(playerid,params[])
{
    if(antiflood[playerid] > 0) return SendClientMessage(playerid, COLOR_WARNING,"Íå ôëóäè!");
    antiflood[playerid]++;
    if(PLAYER_DATA[playerid][data_LOGGED] == false) return SendClientMessage(playerid,COLOR_WARNING,"Âû íå àâòîðèçîâàíû íà ñåðâåðå!");
    if(PLAYER_DATA[playerid][data_ADMLVL] < 1) return true;
	if(sscanf(params,"us[100]",params[0],params[1])) return SendClientMessage(playerid,COLOR_WARNING,"Èñïîëüçóéòå: /pm [èä] [òåêñò]");
	if(!IsPlayerConnected(params[0]))return  SendClientMessage(playerid,COLOR_WARNING,"Äàííîãî ID íåò íà ñåðâåðå!");
	if(PLAYER_DATA[params[0]][data_LOGGED] == false)return  SendClientMessage(playerid,COLOR_WARNING,"Äàííûé èãðîê íå ïðîøåë àâòîðèçàöèþ!");
    NotReklama(playerid, params[1]);
	new string[300];
	new stringpl[300];
    format(string, sizeof(string), "[Îòâåò] %s[%d] èãðîêó %s[%d]: {ffffff}%s", PLAYER_DATA[playerid][data_NAME],playerid,PLAYER_DATA[params[0]][data_NAME],params[0],params[1]);
    format(stringpl, sizeof(stringpl), "Àäìèíèñòðàòîð %s[%d] îòâåòèë âàì: {ffffff}%s", PLAYER_DATA[playerid][data_NAME],playerid,params[1]);
    SendClientMessage(params[0], 0xffa141FF, string);
    SendAdminMessage(0xffa141FF, string);
    return true;
}

