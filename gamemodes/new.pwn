 	}
	
 	if(!strcmp(text,"xD",true))
	{
	    new message[80];
		format(message, sizeof(message), "%s âàëÿåòñÿ îò ñìåõà", PLAYER_DATA[playerid][data_NAME]);
		ProxDetector(20.0, playerid, message, 0xDD90FFFF,0xDD90FFFF,0xDD90FFFF,0xDD90FFFF,0xDD90FFFF);
		SetPlayerChatBubble(playerid, "âàëÿåòñÿ îò ñìåõà", 0xDD90FFFF, 20.0, 4000);
		return false;
	}
	if(!strcmp(text,"(",true))
	{
	    new message[80];
		format(message, sizeof(message), "%s ãðóñòèò", PLAYER_DATA[playerid][data_NAME]);
		ProxDetector(20.0, playerid, message, 0xDD90FFFF,0xDD90FFFF,0xDD90FFFF,0xDD90FFFF,0xDD90FFFF);
		SetPlayerChatBubble(playerid, "ãðóñòèò", 0xDD90FFFF, 20.0, 4000);
		return false;
	}
	if(!strcmp(text,"((",true))
	{
	    new message[80];
		format(message, sizeof(message), "%s ñèëüíî ðàññòðîèëñÿ", PLAYER_DATA[playerid][data_NAME]);
		ProxDetector(20.0, playerid, message, 0xDD90FFFF,0xDD90FFFF,0xDD90FFFF,0xDD90FFFF,0xDD90FFFF);
		SetPlayerChatBubble(playerid, "ñèëüíî ðàññòðîèëñÿ", 0xDD90FFFF, 20.0, 4000);
		return false;
	}
	if(!strcmp(text,"÷Â",true))
	{
	    new message[80];
		format(message, sizeof(message), "%s âàëÿåòñÿ îò ñìåõà", PLAYER_DATA[playerid][data_NAME]);
		ProxDetector(20.0, playerid, message, 0xDD90FFFF,0xDD90FFFF,0xDD90FFFF,0xDD90FFFF,0xDD90FFFF);
		SetPlayerChatBubble(playerid, "âàëÿåòñÿ îò ñìåõà", 0xDD90FFFF, 20.0, 4000);
		return false;
	}
	if(!strcmp(text,")",true))
	{
	    new message[80];
		format(message, sizeof(message), "%s óëûáàåòñÿ", PLAYER_DATA[playerid][data_NAME]);
		ProxDetector(20.0, playerid, message, 0xDD90FFFF,0xDD90FFFF,0xDD90FFFF,0xDD90FFFF,0xDD90FFFF);
		SetPlayerChatBubble(playerid, "óëûáàåòñÿ", 0xDD90FFFF, 20.0, 4000);
		return false;
	}
	if(!strcmp(text,"))",true))
	{
	    new message[80];
		format(message, sizeof(message), "%s ñìå¸òñÿ", PLAYER_DATA[playerid][data_NAME]);
		ProxDetector(20.0, playerid, message, 0xDD90FFFF,0xDD90FFFF,0xDD90FFFF,0xDD90FFFF,0xDD90FFFF);
		SetPlayerChatBubble(playerid, "ñìå¸òñÿ", 0xDD90FFFF, 20.0, 4000);
		return false;
	}
    new message[300];
    format(message, sizeof(message), "- %s %s(%s) [%d]", text, PLAYER_COLOR_CHAT[PLAYER_DATA[playerid][data_MEMBER]][COLOR], PLAYER_DATA[playerid][data_NAME], playerid);
	ProxDetector(30.0, playerid, message, 0xFFFFFFC8, 0xDBDBDBC8, 0xADADADC8, 0x939393C8, 0x737373C8);
	SetPlayerChatBubble(playerid, text, 0xA5DF00AA, 20.0, 4000);
	if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT && GetPVarInt(playerid,"UseAnim") == 0)
 	{
 		ApplyAnimation(playerid,"PED","IDLE_chat",4.1,0,1,1,1,1);
