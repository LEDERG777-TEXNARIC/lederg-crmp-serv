    if(PLAYER_DATA[playerid][data_ADMLVL] < 1) return true;
	if(GetPVarInt(playerid, "SpecBool") == 0) return SendClientMessage(playerid,COLOR_WARNING,"Âû íå íàõîäèòåñü â ñòàòóñå ñëåæåíèÿ!");
    SetPVarInt(playerid,"spawn_ac",1);
