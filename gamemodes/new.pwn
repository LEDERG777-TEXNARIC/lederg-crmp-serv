public OnPlayerPickUpDynamicPickup(playerid, pickupid)
{
    SetPVarInt(playerid,"pickup",pickupid);
    new b = GetPVarInt(playerid, "business");
    
    
    if(pickupid == army_sklad)
    {
        switch(PLAYER_DATA[playerid][data_MEMBER])
        {
            case 2,5,6,7:
			{
			    if(army_wh[0] > 3 && army_wh[1] > 3)
			    {
			        if(PLAYER_DATA[playerid][data_PATR] < 500 && PLAYER_DATA[playerid][data_MET] < 500)
			        {
						new patr,met,str[28];
						patr = RandomEX(1,3);
						met = RandomEX(1,3);
			            PLAYER_DATA[playerid][data_PATR] += patr;
			            PLAYER_DATA[playerid][data_MET] += met;
			            if(PLAYER_DATA[playerid][data_PATR] > 500) PLAYER_DATA[playerid][data_PATR] = 500;
			            if(PLAYER_DATA[playerid][data_MET] > 500) PLAYER_DATA[playerid][data_MET] = 500;
			            
			            army_wh[0] -= met;
			            army_wh[1] -= patr;
			            format(str,sizeof(str),"~p~met +%d~n~patr +%d",met,patr);
			         	GameTextForPlayer(playerid, str, 1000, 6);
			        }
			        else if(PLAYER_DATA[playerid][data_PATR] < 500 && PLAYER_DATA[playerid][data_MET] == 500)
			        {
			            new patr,str[28];
						patr = RandomEX(1,3);
			            PLAYER_DATA[playerid][data_PATR] += patr;
			            if(PLAYER_DATA[playerid][data_PATR] > 500) PLAYER_DATA[playerid][data_PATR] = 500;

			            army_wh[1] -= patr;
			            
			            format(str,sizeof(str),"~p~patr +%d",patr);
			         	GameTextForPlayer(playerid, str, 1000, 6);
			        }
			        else if(PLAYER_DATA[playerid][data_PATR] == 500 && PLAYER_DATA[playerid][data_MET] < 500)
			        {
			            new met,str[28];
						met = RandomEX(1,3);
			            PLAYER_DATA[playerid][data_MET] += met;
			            if(PLAYER_DATA[playerid][data_MET] > 500) PLAYER_DATA[playerid][data_MET] = 500;


                        army_wh[0] -= met;
			            
			            format(str,sizeof(str),"~p~met +%d",met);
			         	GameTextForPlayer(playerid, str, 1000, 6);
			        }
			        else GameTextForPlayer(playerid, "~r~is full", 1000, 6);
			    }
			    else if(army_wh[0] < 3 && army_wh[1] > 3)
			    {
			        if(PLAYER_DATA[playerid][data_PATR] < 500)
			        {
			            new patr,str[28];
						patr = RandomEX(1,3);
			            PLAYER_DATA[playerid][data_PATR] += patr;
			            if(PLAYER_DATA[playerid][data_PATR] > 500) PLAYER_DATA[playerid][data_PATR] = 500;


			            army_wh[1] -= patr;
			            
			            format(str,sizeof(str),"~p~patr +%d",patr);
			         	GameTextForPlayer(playerid, str, 1000, 6);
			        }
                    else GameTextForPlayer(playerid, "~r~is full", 1000, 6);
			    }
			    else if(army_wh[0] > 3 && army_wh[1] < 3)
			    {
			        if(PLAYER_DATA[playerid][data_MET] < 500)
			        {
			            new met,str[28];
						met = RandomEX(1,3);
			            PLAYER_DATA[playerid][data_MET] += met;
			            if(PLAYER_DATA[playerid][data_MET] > 500) PLAYER_DATA[playerid][data_MET] = 500;

                        army_wh[0] -= met;
			            
			            format(str,sizeof(str),"~p~met +%d",met);
			         	GameTextForPlayer(playerid, str, 1000, 6);
			        }
			        else GameTextForPlayer(playerid, "~r~is full", 1000, 6);
			    }
			    else GameTextForPlayer(playerid, "~r~empty", 1000, 6);
			    
			    new str1[256];
            	format(str1,sizeof(str1),"{3366FF}Ñêëàä àðìèè\n{FFFFFF}Ìåòàëëà íà ñêëàäå: {FF6600}%d øò.\n{FFFFFF}Ïàòðîíîâ íà ñêëàäå: {FF6600}%d øò.",army_wh[0],army_wh[1]);
       			UpdateDynamic3DTextLabelText(army_sklad_text, -1, str1);
			}
        }
        return true;
    }
    
    if(pickupid == JB_DATA[0][data_PICKUP][0] || pickupid == JB_DATA[1][data_PICKUP][0] || pickupid == JB_DATA[2][data_PICKUP][0] ||
	pickupid == JB_DATA[3][data_PICKUP][0] || pickupid == AB_DATA[0][data_PICKUP][0] || pickupid == AB_DATA[1][data_PICKUP][0])
	{
	    return true;
	}
    
    if(PLAYER_DATA[playerid][data_PU] == 1) return false;
	else
	{
		PLAYER_DATA[playerid][data_PU] = 1;
		GetPlayerPos(playerid, PosPU[0][playerid], PosPU[1][playerid], PosPU[2][playerid]);
	}
	

	for(new h = 0; h < TotalHouses; h++)
	{
		if(HOUSE_DATA[h][data_PICKUPENTER] == pickupid)
		{
			SetPVarInt(playerid, "house", h);
	      	new dtext[140];
	       	if(HOUSE_DATA[h][data_OWNED] == 1)
	      	{
				new h_online[24];
				for(new x = 0; x < MAX_PLAYERS; x++)
				{
					if(!IsPlayerConnected(x)) continue;
					if(PLAYER_DATA[x][data_HOUSE] == h)
					{
						strmid(h_online, "{339933}online{FFFFFF}", 0, 24, 24);
						break;
					}
					else strmid(h_online, "{FF0000}offline{FFFFFF}", 0, 24, 24);
				}
		  		format(dtext,sizeof(dtext),"{FFFFFF}Íîìåð äîìà: %d\nÂëàäåëåö: %s [%s]\nÑòîèìîñòü: %d ðóáëåé\n\n{D0FA58}Îïëà÷åí íà %d äíÿ/äíåé",h+1, HOUSE_DATA[h][data_OWNER],h_online, HOUSE_DATA[h][data_PRICE], HOUSE_DATA[h][data_DAY]);
		  		ShowPlayerDialogFix(playerid, dialog_ENTER_HOUSE, DIALOG_STYLE_MSGBOX, "{FFCC00}Äîì", dtext, "Âîéòè", "Îòìåíà");
              	return true;
			}
	    	else
	      	{
	    		format(dtext,sizeof(dtext),"{FFFFFF}Íîìåð äîìà: %d\nÑòîèìîñòü: %d ðóáëåé\n\n{FFCC00}Äëÿ ïîêóïêè äîìà èñïîëüçóéòå: /buy",h+1,HOUSE_DATA[h][data_PRICE]);
		     	ShowPlayerDialogFix(playerid, dialog_ENTER_HOUSE, DIALOG_STYLE_MSGBOX, "{FFCC00}Äîì", dtext, "Âîéòè", "Îòìåíà");
              	return true;
			}
		}
	}
	if(pickupid == rentcater)
	{
		ShowPlayerDialogFix(playerid, dialog_RENTCATER, DIALOG_STYLE_MSGBOX, "{FFCC00}Àðåíäà êàòåðà", "{FFFFFF}Âû æåëàåòå àðåíäîâàòü ïðîãóëî÷íûé êàòåð çà 25.000 ðóáëåé?", "Àðåíäîâàòü", "Îòìåíà");
		return true;
	}
	
	
	
	
	if(pickupid == pickcartrack)
	{
		if(PLAYER_DATA[playerid][data_CT_NUMBER] != 0) return SendClientMessage(playerid, COLOR_WARNING,"Âû óæå çàðåãèñòðèðîâàëèñü íà ó÷àñòèå â ãîíêå!");
	    if(cartrack_status == false) return SendClientMessage(playerid, COLOR_WARNING, "Â äàííûé ìîìåíò ðåãèñòðàöèÿ ó÷àñòíèêîâ çàêðûòà!");
		if(cartrack_people >= 15) return SendClientMessage(playerid, COLOR_WARNING, "Íåò ñâîáîäíûõ ìåñò!");
		if(PLAYER_DATA[playerid][data_LICB] == 0) return SendClientMessage(playerid, COLOR_WARNING, "Ó Âàñ íåò âîäèòåëüñêèõ ïðàâ!");
		new str[145];
		format(str,sizeof(str),"Âû óñïåøíî çàðåãèñòðèðîâàëèñü. Âàø íîìåð: %d",cartrack_people+1);
		SendClientMessage(playerid, 0xFFFF66FF, str);
		cartrack_people++;
		PLAYER_DATA[playerid][data_CT_NUMBER] = cartrack_people;
		return true;
	}
	
	if(pickupid == pickcs)
	{
		if(PLAYER_DATA[playerid][data_CS_TEAM] != 0) return SendClientMessage(playerid, COLOR_WARNING,"Âû óæå çàðåãèñòðèðîâàëèñü íà èãðó!");
	    if(cs_status == false) return SendClientMessage(playerid, COLOR_WARNING, "Â äàííûé ìîìåíò ðåãèñòðàöèÿ ó÷àñòíèêîâ çàêðûòà!");
		if(cs_people >= 20) return SendClientMessage(playerid, COLOR_WARNING, "Íåò ñâîáîäíûõ ìåñò!");
		
		if(cs_people%2 == 0)
		{
			SendClientMessage(playerid, 0xFFFF66FF,"Âû óñïåøíî çàðåãèñòðèðîâàëèñü. Âàøà êîìàíäà: Àðìèÿ");
			PLAYER_DATA[playerid][data_CS_TEAM] = 1;
		}
		else
		{
		    SendClientMessage(playerid, 0xFFFF66FF,"Âû óñïåøíî çàðåãèñòðèðîâàëèñü. Âàøà êîìàíäà: ÎÌÎÍ");
		    PLAYER_DATA[playerid][data_CS_TEAM] = 2;
		}
		cs_people++;
		return true;
	}
	
	
	if(pickupid == pickgmats)
	{
		switch(PLAYER_DATA[playerid][data_MEMBER])
		{
		    case 2:
		    {
		        if(PLAYER_DATA[playerid][data_PUTPATR] == 0 && PLAYER_DATA[playerid][data_PUTMET] == 0)
		        {
		            PLAYER_DATA[playerid][data_PUTPATR] = 1;
		            SetPlayerAttachedObject(playerid, 3, 3013,5,0.040999,0.202999,0.192999,101.299987,1.999999,75.800003,1.000000,1.000000,1.000000);
		    		SetPlayerSpecialAction(playerid,25);
					SendClientMessage(playerid, -1, "Ïîäîéäèòå ê ãðóçîâèêó è ââåäèòå: /put");
		        }
		    }
		}
		return true;
	}
	if(pickupid == pickgmets)
	{
		switch(PLAYER_DATA[playerid][data_MEMBER])
		{
		    case 2:
		    {
		        if(PLAYER_DATA[playerid][data_PUTMET] == 0 && PLAYER_DATA[playerid][data_PUTPATR] == 0)
		        {
		            PLAYER_DATA[playerid][data_PUTMET] = 1;
		            SetPlayerAttachedObject(playerid, 3, 3013,5,0.040999,0.202999,0.192999,101.299987,1.999999,75.800003,1.000000,1.000000,1.000000);
		    		SetPlayerSpecialAction(playerid,25);
					SendClientMessage(playerid, -1, "Ïîäîéäèòå ê ãðóçîâèêó è ââåäèòå: /put");
		        }
		    }
		}
	    return true;
	}
	
	
	if(pickupid == rostov_sklad && PLAYER_DATA[playerid][data_MEMBER] == 5)
	{
	    ShowPlayerDialogFix(playerid, dialog_SKLAD, DIALOG_STYLE_LIST, "{FFCC00}Ñêëàä", "{FFFFFF}Âçÿòü ìåòàëë ñî ñêëàäà\nÏîëîæèòü ìåòàëë íà ñêëàä\nÂçÿòü ïàòðîíû ñî ñêëàäà\nÏîëîæèòü ïàòðîíû íà ñêëàä\nÂçÿòü íàðêîòèêè ñî ñêëàäà\nÏîëîæèòü íàðêîòèêè íà ñêëàä", "Âûáðàòü", "Îòìåíà");
		return true;
	}
