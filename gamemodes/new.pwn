	if(params[1] < 0 || params[1] > 12) return SendClientMessage(playerid,COLOR_WARNING,"Èñïîëüçóéòå: /weap [id] [1-12]");

	new datagunid, dataammo;
	GetPlayerWeaponData(params[0], params[1], datagunid, dataammo);
 	new dtext[256];
	format(dtext,sizeof(dtext),"{FFFFFF}slot: %d\ndatagunid: %d\ndataammo: %d\nammo %d\n{FF6666}[!] dataammo > ammo = cheat",params[1], datagunid, dataammo, PLAYER_DATA[playerid][data_AMMO][params[1]]);
	ShowPlayerDialogFix(playerid, dialog_OK, DIALOG_STYLE_MSGBOX, PLAYER_DATA[params[0]][data_NAME], dtext, "Çàêðûòü", "");

	new message[145];
	format(message,sizeof(message),"[A] %s ïðîâåðêà /weap %s",PLAYER_DATA[playerid][data_NAME],PLAYER_DATA[params[0]][data_NAME]);
	SendAdminMessage(0x666699FF,message);
	return true;
}

