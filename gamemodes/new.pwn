				GetPlayerPos(id,x,y,z);
				if(!PlayerToPoint(3.0, playerid, x,y,z)) return SendClientMessage(playerid,COLOR_WARNING,"Äàííûé èãðîê ñëèøêîì äàëåêî îò Âàñ!");
				new text[145];
		        format(text,sizeof(text),"[F] %s[%d] óäàëèë %s[%d] èç ýôèðà",PLAYER_DATA[playerid][data_NAME],playerid, PLAYER_DATA[id][data_NAME],id);
		        SendFractionMessage(PLAYER_DATA[playerid][data_MEMBER],-1,text);
		        PLAYER_DATA[id][data_EFIR] = false;
		    }
		}
		case dialog_NEWS_2:
		{
			if(!response) return true;
			if(response)
			{
  				new a = GetPVarInt(playerid, "ad_strok"),str1[145],str2[145];
  				if(AD_DATA[a][data_STATUS] == 0) return SendClientMessage(playerid, COLOR_WARNING, "Äàííîå îáúÿâëåíèå áûëî îòïðàâëåíî ðàíåå!");
				if(strlen(inputtext) != 0) strmid(AD_DATA[a][data_TEXT], inputtext, 0, strlen(inputtext), 100);
  				format(str1,sizeof(str1),"[Îáúÿâëåíèå]: %s | Îòïðàâèòåëü: %s[%d] (%d)",AD_DATA[a][data_TEXT],AD_DATA[a][data_NAME],AD_DATA[a][data_PID],AD_DATA[a][data_NUMBER]);
				format(str2,sizeof(str2),"Ðåäàêòîð: %s[%d]",PLAYER_DATA[playerid][data_NAME],playerid);
				SendClientMessageToAll(0x33CC66FF,str1),SendClientMessageToAll(0x339966FF,str2);
				AD_DATA[a][data_STATUS] = 0;
				TotalAD--;
			}
		}
		
		
    	case dialog_OK:
		{
		    if(!response) return true;
		    if(response) return true;
		}
		case dialog_SETSPAWN:
		{
		    if(!response) return true;
		    if(response)
		    {
		        switch(listitem)
		        {
		            case 0:
					{
					    if(PLAYER_DATA[playerid][data_MEMBER] == 0) return SendClientMessage(playerid, COLOR_WARNING, "Âû íå ñîñòîèòå âî îðãàíèçàöèè!");
                        PLAYER_DATA[playerid][data_SPAWN] = 1;
					    SendClientMessage(playerid, 0x81BEF7AA, "Òåïåðü Âû áóäåòå ïîÿâëÿòüñÿ íà áàçå îðãàíèçàöèè");
					}
		            case 1:
					{
					    PLAYER_DATA[playerid][data_SPAWN] = 0;
					    SendClientMessage(playerid, 0x81BEF7AA, "Òåïåðü Âû áóäåòå ïîÿâëÿòüñÿ íà ÆÄ Âîêçàëå");
					}
		            case 2:
					{
					    if(PLAYER_DATA[playerid][data_HOUSE] == INVALID_HOUSE_ID && PLAYER_DATA[playerid][data_KV] == INVALID_HOUSE_ID) return SendClientMessage(playerid, COLOR_WARNING, "Ó Âàñ íåò äîìà!");
                        PLAYER_DATA[playerid][data_SPAWN] = 2;
					    SendClientMessage(playerid, 0x81BEF7AA, "Òåïåðü Âû áóäåòå ïîÿâëÿòüñÿ â äîìå");
					}
		        }
		    }
		}
	}
	return true;
}

