		case 1: format(abis,sizeof(abis),"'Íàâèãàòîð'");
	}
	switch(PLAYER_DATA[playerid][data_JB])
	{
		case INVALID_JB_ID: jbis = "Íåò";
		case 0: format(jbis,sizeof(jbis),"ÎÎÎ 'Ïèëîìàòåðèàëû'");
		case 1: format(jbis,sizeof(jbis),"ÎÎÎ 'Ðóäíèê'");
		case 2: format(jbis,sizeof(jbis),"ÎÎÎ 'Ñàä'");
		case 3: format(jbis,sizeof(jbis),"ÎÎÎ 'Îãîðîä'");
	}
	
	
	switch(PLAYER_DATA[playerid][data_MEMBER])
	{
	    case 0: org_text = "Íåò";
		case 1: org_text = "Ïðàâèòåëüñòâî";
		case 2: org_text = "Àðìèÿ";
		case 3: org_text = "Ïîëèöèÿ";
		case 4: org_text = "Áîëüíèöà";
		case 5: org_text = "Áàíäåðà ÎÏÃ";
		case 6: org_text = "LEDERG ÎÏÃ";
		case 7: org_text = "Âàãíåð ÎÏÃ";
		case 8: org_text = "ÔÑÁ";
		case 9: org_text = "ÑÌÈ";
	}
	switch(PLAYER_DATA[playerid][data_PODMEMBER])
	{
	    case 0: podfrak = "ÏÏÑ";
		case 1: podfrak = "ÃÈÁÄÄ";
		case 2: podfrak = "ÎÌÎÍ";
	}
	switch(PLAYER_DATA[playerid][data_SEX])
	{
		case 1: sex_text = "Ìóæñêîé";
		case 2: sex_text = "Æåíñêèé";
	}
	new nextlvl = PLAYER_DATA[playerid][data_LVL]+1;
	new nextexp = nextlvl*4;
	format(str,sizeof(str),"{FFFFFF}Íîìåð àêêàóíòà:\t\t%d\n",PLAYER_DATA[playerid][data_ID]);
	strcat(sctring,str);
	format(str,sizeof(str),"{FFFFFF}Èìÿ:\t\t\t\t%s\n",PLAYER_DATA[playerid][data_NAME]);
