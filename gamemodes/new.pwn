}

CMD:put(playerid,params[])
{
    if(antiflood[playerid] > 0) return SendClientMessage(playerid, COLOR_WARNING,"Íå ôëóäè!");
    antiflood[playerid]++;
	if(PLAYER_DATA[playerid][data_LOGGED] == false) return SendClientMessage(playerid,COLOR_WARNING,"Âû íå àâòîðèçîâàíû íà ñåðâåðå!");
    if(PLAYER_DATA[playerid][data_MEMBER] == 2)
	{
	    if(PLAYER_DATA[playerid][data_PUTPATR] == 0 && PLAYER_DATA[playerid][data_PUTMET] == 0) return SendClientMessage(playerid, COLOR_WARNING,"Ó Âàñ íåò â ðóêàõ ÿùèêà!");
		for(new c = 0; c < MAX_VEHICLES; c++)
		{
			new model = GetVehicleModel(c);
			new Float:x,Float:y,Float:z;
			GetCoordBootVehicle(c, x, y, z);
			if(PlayerToPoint(2.0, playerid, x, y, z))
		 	{
				if(model != 433) return SendClientMessage(playerid,COLOR_WARNING, "Ýòî íå ñïåöèàëüíûé ãðóçîâèê!");
				
				if(PLAYER_DATA[playerid][data_PUTPATR] != 0)
				{
					if(CAR_DATA[c][data_PATR] >= 10000) return SendClientMessage(playerid,COLOR_WARNING, "Â ãðóçîâèêå íåäîñòàòî÷íî ìåñòà!");
	                CAR_DATA[c][data_PATR] += 500;
	                PLAYER_DATA[playerid][data_PUTPATR] = 0;
	                GameTextForPlayer(playerid, "~g~PUT PATR", 1000, 1);
	                if(IsPlayerAttachedObjectSlotUsed(playerid, 3)) RemovePlayerAttachedObject(playerid, 3);
	                SetPlayerSpecialAction(playerid,0);
	                return true;
                }
                else if(PLAYER_DATA[playerid][data_PUTMET] != 0)
				{
					if(CAR_DATA[c][data_MET] >= 10000) return SendClientMessage(playerid,COLOR_WARNING, "Â ãðóçîâèêå íåäîñòàòî÷íî ìåñòà!");
	                CAR_DATA[c][data_MET] += 500;
	                PLAYER_DATA[playerid][data_PUTMET] = 0;
	                GameTextForPlayer(playerid, "~g~PUT MET", 1000, 1);
	                if(IsPlayerAttachedObjectSlotUsed(playerid, 3)) RemovePlayerAttachedObject(playerid, 3);
	                SetPlayerSpecialAction(playerid,0);
	                return true;
                }
			}
		}
		PLAYER_DATA[playerid][data_PUTPATR] = 0;
		PLAYER_DATA[playerid][data_PUTMET] = 0;
		GameTextForPlayer(playerid, "~r~PUT", 1000, 1);
		if(IsPlayerAttachedObjectSlotUsed(playerid, 3)) RemovePlayerAttachedObject(playerid, 3);
		SetPlayerSpecialAction(playerid,0);
	}
	else SendClientMessage(playerid, COLOR_WARNING, "Âàì íåäîñòóïíà äàííàÿ êîìàíäà!");
	return true;
}

CMD:bar(playerid,params[])
{
    if(antiflood[playerid] > 0) return SendClientMessage(playerid, COLOR_WARNING,"Íå ôëóäè!");
    antiflood[playerid]++;
	if(PLAYER_DATA[playerid][data_LOGGED] == false) return SendClientMessage(playerid,COLOR_WARNING,"Âû íå àâòîðèçîâàíû íà ñåðâåðå!");

	new Float:x,Float:y,Float:z,model;
	for(new c = 0; c < MAX_VEHICLES; c++)
	{
	    GetVehiclePos(c,x,y,z);
	    model = GetVehicleModel(c);
	    if(PlayerToPoint(10.0, playerid, x,y,z) && model == 454)
		{
		    ShowPlayerDialogFix(playerid, dialog_CATER, DIALOG_STYLE_LIST, "{FFCC00}Áàð", "Ñïðàíê\nÊîôå\nÏèâî\nÂîäêà\nÂèíî\nÊîíüÿê\nÂèñêè\nÐîì", "Âûáðàòü", "Îòìåíà");
			break;
		}
	}
	return true;
}

CMD:gunload(playerid,params[])
{
    if(antiflood[playerid] > 0) return SendClientMessage(playerid, COLOR_WARNING,"Íå ôëóäè!");
    antiflood[playerid]++;
	if(PLAYER_DATA[playerid][data_LOGGED] == false) return SendClientMessage(playerid,COLOR_WARNING,"Âû íå àâòîðèçîâàíû íà ñåðâåðå!");
    if(PLAYER_DATA[playerid][data_MEMBER] == 2)
	{
	    new car = GetPlayerVehicleID(playerid);
	    new model = GetVehicleModel(car);
	    new materials = CAR_DATA[car][data_PATR];
		new metals = CAR_DATA[car][data_MET];
	    if(model != 433) return SendClientMessage(playerid, COLOR_WARNING, "Íóæíî íàõîäèòüñÿ â ñïåöèàëüíîì ãðóçîâèêå!");

		if(PlayerToPoint(30.0, playerid, 1219.9703,-319.2863,4.0040) && PLAYER_DATA[playerid][data_MEMBER] == 2)
	    {
	        if(car >= army_car[0] && car <= army_car[1])
	        {
	            if(CAR_DATA[car][data_PATR] != 0 || CAR_DATA[car][data_MET] != 0)
	            {
					army_wh[1] += materials;
					CAR_DATA[car][data_PATR] = 0;
					
					army_wh[0] += metals;
					CAR_DATA[car][data_MET] = 0;
					
					new str[145];
					format(str,sizeof(str),"[F] %s[%d] ðàçãðóçèë(à) ãðóçîâèê ñ áîåïðèïàñàìè. (+%d ïàòðîíîâ, +%d ìåòàëëà)",PLAYER_DATA[playerid][data_NAME],playerid, materials, metals);
					SendFractionMessage(PLAYER_DATA[playerid][data_MEMBER],0xFF9999FF,str);
					
					new str1[256];
            		format(str1,sizeof(str1),"{3366FF}Ñêëàä àðìèè\n{FFFFFF}Ìåòàëëà íà ñêëàäå: {FF6600}%d øò.\n{FFFFFF}Ïàòðîíîâ íà ñêëàäå: {FF6600}%d øò.",army_wh[0],army_wh[1]);
       				UpdateDynamic3DTextLabelText(army_sklad_text, -1, str1);
					
					return true;
				}
                SendClientMessage(playerid, COLOR_WARNING, "Ãðóçîâèê ïóñò!");
			}
			else SendClientMessage(playerid, COLOR_WARNING, "Íóæíî íàõîäèòüñÿ â ñïåöèàëüíîì ãðóçîâèêå!");
		}
	}
	else SendClientMessage(playerid, COLOR_WARNING, "Âàì íåäîñòóïíà äàííàÿ êîìàíäà!");
	return true;
}

CMD:lock(playerid)
{
    if(antiflood[playerid] > 0) return SendClientMessage(playerid, COLOR_WARNING,"Íå ôëóäè!");
    antiflood[playerid]++;
	if(PLAYER_DATA[playerid][data_LOGGED] == false) return SendClientMessage(playerid,COLOR_WARNING,"Âû íå àâòîðèçîâàíû íà ñåðâåðå!");
	for(new c = 0; c < MAX_VEHICLES; c++)
	{
		if(c == PLAYER_DATA[playerid][data_VEH])
		{
			new Float:x,Float:y,Float:z;
		    GetVehiclePos(c,x,y,z);
			if(!PlayerToPoint(5.0, playerid, x,y,z)) return SendClientMessage(playerid,COLOR_WARNING,"Âû íàõîäèòåñü äàëåêî îò ëè÷íîãî òðàíñïîðòà!");
			switch(CAR_DATA[c][data_LOCK])
			{
				case 0:
				{
				    PlayerPlaySound(playerid, 25800, 0.0, 0.0, 0.0);
					GetVehicleParamsEx(c,engine,lights,alarm,doors,bonnet,boot,objective);
					SetVehicleParamsEx(c,engine,lights,alarm,true,bonnet,boot,objective);
					CAR_DATA[c][data_LOCK] = 1;
					GameTextForPlayer(playerid, "~r~LOCK", 1000, 4);
				}
				case 1:
				{
				    PlayerPlaySound(playerid, 25800, 0.0, 0.0, 0.0);
					GetVehicleParamsEx(c,engine,lights,alarm,doors,bonnet,boot,objective);
					SetVehicleParamsEx(c,engine,lights,alarm,false,bonnet,boot,objective);
					CAR_DATA[c][data_LOCK] = 0;
					GameTextForPlayer(playerid, "~g~LOCK", 1000, 4);
				}
			}
		}
	}
	return true;
}

CMD:ogo(playerid)
{
    if(antiflood[playerid] > 0) return SendClientMessage(playerid, COLOR_WARNING,"Íå ôëóäè!");
    antiflood[playerid]++;
	if(PLAYER_DATA[playerid][data_LOGGED] == false) return SendClientMessage(playerid,COLOR_WARNING,"Âû íå àâòîðèçîâàíû íà ñåðâåðå!");
    if(PLAYER_DATA[playerid][data_ADMLVL] < 5) return true;
    
    if(ooc == false)
    {
        new str[145];
        format(str,sizeof(str),"*** Àäìèíèñòðàòîð %s âêëþ÷èë îáùèé ÷àò (/o [òåêñò]) ***",PLAYER_DATA[playerid][data_NAME]);
        SendClientMessageToAll(-1, str);
    	ooc = true;
    }
    else
    {
        new str[145];
        format(str,sizeof(str),"*** Àäìèíèñòðàòîð %s îòêëþ÷èë îáùèé ÷àò ***",PLAYER_DATA[playerid][data_NAME]);
        SendClientMessageToAll(-1, str);
        ooc = false;
    }
	return true;
}

CMD:o(playerid,params[])
{
    if(antiflood[playerid] > 0) return SendClientMessage(playerid, COLOR_WARNING,"Íå ôëóäè!");
    antiflood[playerid]++;
	if(PLAYER_DATA[playerid][data_LOGGED] == false) return SendClientMessage(playerid,COLOR_WARNING,"Âû íå àâòîðèçîâàíû íà ñåðâåðå!");
