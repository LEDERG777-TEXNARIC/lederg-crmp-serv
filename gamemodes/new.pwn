                    SendClientMessage(playerid, 0x33CC99FF, "Âû ïîäîáðàëè ïîäàðîê. Ïîëó÷åíî: 7050 ðóáëåé");
                }
                case 2:
                {
                    give_player_money(playerid, 5200, "pod");
                    SendClientMessage(playerid, 0x33CC99FF, "Âû ïîäîáðàëè ïîäàðîê. Ïîëó÷åíî: 5200 ðóáëåé");
                }
                case 3:
                {
                    give_player_money(playerid, 1150, "pod");
                    SendClientMessage(playerid, 0x33CC99FF, "Âû ïîäîáðàëè ïîäàðîê. Ïîëó÷åíî: 1150 ðóáëåé");
                }
                case 4:
                {
					give_player_money(playerid, 560, "pod");
                    SendClientMessage(playerid, 0x33CC99FF, "Âû ïîäîáðàëè ïîäàðîê. Ïîëó÷åíî: 560 ðóáëåé");
