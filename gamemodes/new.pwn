CMD:heal(playerid,params[])
{
    if(antiflood[playerid] > 0) return SendClientMessage(playerid, COLOR_WARNING,"Íå ôëóäè!");
    antiflood[playerid]++;
    if(PLAYER_DATA[playerid][data_LOGGED] == false) return SendClientMessage(playerid,COLOR_WARNING,"Âû íå àâòîðèçîâàíû íà ñåðâåðå!");
    if(PLAYER_DATA[playerid][data_MEMBER] != 4) return SendClientMessage(playerid, COLOR_WARNING, "Äàííàÿ êîìàíäà äëÿ Âàñ íåäîñòóïíà!");
	if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_WARNING, "Èñïîëüçóéòå: /heal [èä]");
	if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid,COLOR_WARNING,"Äàííîãî ID íåò íà ñåðâåðå!");
	if(PLAYER_DATA[params[0]][data_LOGGED] == false) return SendClientMessage(playerid,COLOR_WARNING,"Äàííûé èãðîê íå ïðîøåë àâòîðèçàöèþ!");
	new Float:x,Float:y,Float:z;
	GetPlayerPos(params[0],x,y,z);
	if(!PlayerToPoint(10.0, playerid, x,y,z)) return SendClientMessage(playerid,COLOR_WARNING,"Äàííûé èãðîê äàëåêî îò Âàñ!");

	if(GetPVarInt(params[0],"yesno") == 1) return SendClientMessage(playerid,COLOR_WARNING,"Èãðîêó óæå ïîñòóïèëî ïðåäëîæåíèå!");

	new str1[145], str2[145];
	format(str1,sizeof(str1),"Âû ïðåäëîæèëè êóðñ ëå÷åíèÿ èãðîêó %s çà 200 ðóáëåé",PLAYER_DATA[params[0]][data_NAME]);
	SendClientMessage(playerid, 0xDD90FFFF, str1);
	format(str2,sizeof(str2),"%s ïðåäëîæèë Âàì êóðñ ëå÷åíèÿ çà 200 ðóáëåé. Äëÿ ñîãëàñèÿ {31B404}Y{FF66CC}, äëÿ îòêàçà íàæìèòå {FE2E2E}N",PLAYER_DATA[playerid][data_NAME]);
	SendClientMessage(params[0], 0xDD90FFFF, str2);

    SetPVarInt(params[0], "yesno_heal", 1);
    SetPVarInt(params[0], "yesno_playerid", playerid);
    SetPVarInt(params[0], "yesno", 1);
	return true;
}

CMD:call(playerid,params[])
{
    if(antiflood[playerid] > 0) return SendClientMessage(playerid, COLOR_WARNING,"Íå ôëóäè!");
    antiflood[playerid]++;
	if(PLAYER_DATA[playerid][data_LOGGED] == false) return SendClientMessage(playerid,COLOR_WARNING,"Âû íå àâòîðèçîâàíû íà ñåðâåðå!");
	if(PLAYER_DATA[playerid][data_PHONE] == 0) return SendClientMessage(playerid,COLOR_WARNING,"Ó Âàñ íåò òåëåôîíà!");
	if(PLAYER_DATA[playerid][data_NUMBER] == 0) return SendClientMessage(playerid,COLOR_WARNING,"Ó Âàñ íåò SIM êàðòû!");
    if(sscanf(params, "d", params[0])) return SendClientMessage(playerid, COLOR_WARNING, "Èñïîëüçóéòå: /call [íîìåð]");
    if(PLAYER_DATA[playerid][data_NUMBER] == params[0]) return SendClientMessage(playerid,COLOR_WARNING,"Íåëüçÿ ïîçâîíèòü ñàìîìó ñåáå!");

    if(params[0] == 222)
    {
        if(PLAYER_DATA[playerid][data_911_1] > 0) return SendClientMessage(playerid, COLOR_WARNING, "Íåëüçÿ âûçûâàòü ïîëèöèþ ñëèøêîì ÷àñòî!");
		ShowPlayerDialogFix(playerid, dialog_911_1, DIALOG_STYLE_INPUT, "{FFCC00}Ïîëèöèÿ", "{FFFFFF}Ñîîáùèòå Âàøó ïðîáëåìó è ìåñòîíàõîæäåíèå", "Ïîäòâåðäèòü", "Îòìåíà");
        return true;
    }
    if(params[0] == 333)
    {
        if(PLAYER_DATA[playerid][data_911_2] > 0) return SendClientMessage(playerid, COLOR_WARNING, "Íåëüçÿ âûçûâàòü ñêîðóþ ïîìîùü ñëèøêîì ÷àñòî!");
		ShowPlayerDialogFix(playerid, dialog_911_2, DIALOG_STYLE_INPUT, "{FFCC00}Ñêîðàÿ ïîìîùü", "{FFFFFF}Ñîîáùèòå Âàøó ïðîáëåìó è ìåñòîíàõîæäåíèå", "Ïîäòâåðäèòü", "Îòìåíà");
        return true;
    }
    
    
	for(new i = 0; i < MAX_PLAYERS; i++)
	{
	    if(!IsPlayerConnected(i)) continue;
		if(PLAYER_DATA[i][data_NUMBER] == params[0])
 		{
   			if(PLAYER_DATA[playerid][data_NUMBER_M] <= 0) return SendClientMessage(playerid,COLOR_WARNING,"Ó Âàñ íåäîñòàòî÷íî äåíåã íà òåëåôîíå!");
      		if(PLAYER_DATA[i][data_CALL] != -1) return SendClientMessage(playerid,COLOR_WARNING,"Äàííûé èãðîê ðàçãîâàðèâàåò ïî òåëåôîíó!");
			PLAYER_DATA[playerid][data_CALL] = i;
      		SendClientMessage(i, -1, "Ó Âàñ çâîíèò òåëåôîí. ×òîáû ïîäíÿòü òðóáêó ââåäèòå: /p");
      		PlayerPlaySound(i, 20600, 0.0, 0.0, 0.0);
      		PlayerPlaySound(playerid, 3600, 0.0, 0.0, 0.0);
      		SendClientMessage(playerid,0xFFCC33FF,"Âûçîâ...");
			if(!IsPlayerInAnyVehicle(playerid)) SetPlayerSpecialAction(playerid, SPECIAL_ACTION_USECELLPHONE);
			return true;
  		}
	}
	SendClientMessage(playerid,COLOR_WARNING,"Äàííîãî èãðîêà íåò íà ñåðâåðå!");
	return true;
}

CMD:p(playerid)
{
    if(antiflood[playerid] > 0) return SendClientMessage(playerid, COLOR_WARNING,"Íå ôëóäè!");
    antiflood[playerid]++;
    if(PLAYER_DATA[playerid][data_LOGGED] == false) return SendClientMessage(playerid,COLOR_WARNING,"Âû íå àâòîðèçîâàíû íà ñåðâåðå!");
	if(PLAYER_DATA[playerid][data_PHONE] == 0) return SendClientMessage(playerid,COLOR_WARNING,"Ó Âàñ íåò òåëåôîíà!");
	if(PLAYER_DATA[playerid][data_NUMBER] == 0) return SendClientMessage(playerid,COLOR_WARNING,"Ó Âàñ íåò SIM êàðòû!");
	for(new i = 0; i < MAX_PLAYERS; i++)
	{
