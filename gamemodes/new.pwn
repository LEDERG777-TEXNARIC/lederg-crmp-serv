CMD:mphp(playerid,params[])
{
    if(antiflood[playerid] > 0) return SendClientMessage(playerid, COLOR_WARNING,"Íå ôëóäè!");
    antiflood[playerid]++;
    if(PLAYER_DATA[playerid][data_LOGGED] == false) return SendClientMessage(playerid,COLOR_WARNING,"Âû íå àâòîðèçîâàíû íà ñåðâåðå!");
    if(PLAYER_DATA[playerid][data_ADMLVL] < 4) return true;
	if(sscanf(params,"d",params[0])) return SendClientMessage(playerid,COLOR_WARNING,"Èñïîëüçóéòå: /mphp [êîë-âî]");
	
	new Float:x,Float:y,Float:z;
	GetPlayerPos(playerid, x,y,z);


   	for(new i = 0; i < MAX_PLAYERS; i++)
	{
	    if(i == playerid) continue;
		if(!IsPlayerConnected(i)) continue;
		if(PlayerToPoint(100.0, i, x,y,z))
		{
		    SetPlayerHealthAC(playerid, params[0]);
		}
   	}
    return true;
}

