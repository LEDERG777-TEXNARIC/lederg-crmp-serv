	if(sscanf(params,"s[100]",params[0])) return SendClientMessage(playerid,COLOR_WARNING,"Èñïîëüçóéòå: /o [òåêñò]");
    NotReklama(playerid, params[0]);
	
	new str[145];
	format(str,sizeof(str),"[OOC] %s[%d]: %s",PLAYER_DATA[playerid][data_NAME],playerid, params[0]);
	SendClientMessageToAll( -1, str);
	return true;
}


CMD:attach(playerid,params[])
{
    if(antiflood[playerid] > 0) return SendClientMessage(playerid, COLOR_WARNING,"Íå ôëóäè!");
    antiflood[playerid]++;
	if(PLAYER_DATA[playerid][data_LOGGED] == false) return SendClientMessage(playerid,COLOR_WARNING,"Âû íå àâòîðèçîâàíû íà ñåðâåðå!");
    if(PLAYER_DATA[playerid][data_ADMLVL] < 4) return true;
	if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_WARNING, "Èñïîëüçóéòå: /attach [èä]");
    if(!IsPlayerConnected(params[0]))return  SendClientMessage(playerid,COLOR_WARNING,"Äàííîãî ID íåò íà ñåðâåðå!");
	if(PLAYER_DATA[params[0]][data_LOGGED] == false)return  SendClientMessage(playerid,COLOR_WARNING,"Äàííûé èãðîê íå ïðîøåë àâòîðèçàöèþ!");
    
    SetPVarInt(playerid, "attach_id",params[0]);
    new string[128];
	for(new x = 0; x < MAX_PLAYER_ATTACHED_OBJECTS; x++)
 	{
		if(IsPlayerAttachedObjectSlotUsed(params[0], x)) format(string, sizeof(string), "%s%d (Used)\n", string, x);
		else format(string, sizeof(string), "%s%d\n", string, x);
	}
	ShowPlayerDialogFix(playerid, dialog_ATTACH_INDEX_SELECTION, DIALOG_STYLE_LIST, "{FFCC00}Âûáåðèòå ñëîò", string, "Âûáðàòü", "Îòìåíà");
    return true;
}

