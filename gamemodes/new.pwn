CMD:buy(playerid)
{
    if(antiflood[playerid] > 0) return SendClientMessage(playerid, COLOR_WARNING,"Íå ôëóäè!");
    antiflood[playerid]++;
    if(PLAYER_DATA[playerid][data_LOGGED] == false) return SendClientMessage(playerid,COLOR_WARNING,"Âû íå àâòîðèçîâàíû íà ñåðâåðå!");
	
	
	
	for(new k = 0; k < 6; k++)
    {
        new kv = GetPlayerVirtualWorld(playerid)-1;
        if(kv == -1) break;
        if(PlayerToPoint(1.0, playerid, KV_DATA[kv][data_ENTER_POSX][k], KV_DATA[kv][data_ENTER_POSY][k], KV_DATA[kv][data_ENTER_POSZ][k]))
        {
        
            if(PLAYER_DATA[playerid][data_KV] != INVALID_KV_ID || PLAYER_DATA[playerid][data_HOUSE] != INVALID_HOUSE_ID) return SendClientMessage(playerid,COLOR_WARNING,"Ó Âàñ óæå åñòü íåäâèæèìîñòü!");
            if(KV_DATA[kv][data_OWNED][k] == 1) return SendClientMessage(playerid,COLOR_WARNING,"Ó äàííîé êâàðòèðû óæå åñòü âëàäåëåö!");
			if(get_player_money(playerid) < KV_DATA[kv][data_PRICE][k]) return SendClientMessage(playerid,COLOR_WARNING,"Ó Âàñ íåäîñòàòî÷íî äåíåã íà ðóêàõ!");

			PLAYER_DATA[playerid][data_PADIK] = kv;
			PLAYER_DATA[playerid][data_KV] = k;
            KV_DATA[kv][data_OWNED][k] = 1;
            KV_DATA[kv][data_DAY][k] = 3;

            switch(k)
			{
				case 0: strmid(KV_DATA[kv][data_OWNER_1], PLAYER_DATA[playerid][data_NAME], 0, strlen(PLAYER_DATA[playerid][data_NAME]), MAX_PLAYER_NAME);
				case 1: strmid(KV_DATA[kv][data_OWNER_2], PLAYER_DATA[playerid][data_NAME], 0, strlen(PLAYER_DATA[playerid][data_NAME]), MAX_PLAYER_NAME);
				case 2: strmid(KV_DATA[kv][data_OWNER_3], PLAYER_DATA[playerid][data_NAME], 0, strlen(PLAYER_DATA[playerid][data_NAME]), MAX_PLAYER_NAME);
				case 3: strmid(KV_DATA[kv][data_OWNER_4], PLAYER_DATA[playerid][data_NAME], 0, strlen(PLAYER_DATA[playerid][data_NAME]), MAX_PLAYER_NAME);
				case 4: strmid(KV_DATA[kv][data_OWNER_5], PLAYER_DATA[playerid][data_NAME], 0, strlen(PLAYER_DATA[playerid][data_NAME]), MAX_PLAYER_NAME);
				case 5: strmid(KV_DATA[kv][data_OWNER_6], PLAYER_DATA[playerid][data_NAME], 0, strlen(PLAYER_DATA[playerid][data_NAME]), MAX_PLAYER_NAME);
			}

            give_player_money(playerid,-KV_DATA[kv][data_PRICE][k],"#72");
            SendClientMessage(playerid,0xFFCC33FF, "Ïîçäðàâëÿåì Âàñ ñ ïîêóïêîé êâàðòèðû! Îíà áûëà îïëà÷åíà íà 3 äíÿ!");
            SendClientMessage(playerid,0xFFCC33FF, "Äëÿ óïðàâëåíèÿ êâàðòèðîé èñïîëüçóéòå: /house");
            SendClientMessage(playerid, 0x9F81F7FF, "Èñïîëüçóéòå: /setspawn, ÷òîáû èçìåíèòü ìåñòî ïîÿâëåíèÿ");
            
            
            new logtext[64];
			format(logtext,sizeof(logtext),"êóïèë êâàðòèðó ¹%d, ïîäúåçä ID:%d", k+1, KV_DATA[kv][data_ID]);
			LOG("log_player",PLAYER_DATA[playerid][data_NAME], logtext);


            UpdateKVData(kv,k);
            SaveKVData(kv);
           	SavePlayerData(playerid);
           	return true;
        }
    }
    
    for(new h = 0; h < TotalHouses; h++)
    {
        if(PlayerToPoint(3.0, playerid, HOUSE_DATA[h][data_ENTERX], HOUSE_DATA[h][data_ENTERY], HOUSE_DATA[h][data_ENTERZ]))
        {
            if(PLAYER_DATA[playerid][data_KV] != INVALID_KV_ID || PLAYER_DATA[playerid][data_HOUSE] != INVALID_HOUSE_ID) return SendClientMessage(playerid,COLOR_WARNING,"Ó Âàñ óæå åñòü íåäâèæèìîñòü!");
            if(HOUSE_DATA[h][data_OWNED] == 1) return SendClientMessage(playerid,COLOR_WARNING,"Äàííûé äîì óæå êóïëåí!");
			if(get_player_money(playerid) < HOUSE_DATA[h][data_PRICE]) return SendClientMessage(playerid,COLOR_WARNING,"Ó Âàñ íåäîñòàòî÷íî äåíåã íà ðóêàõ!");
			PLAYER_DATA[playerid][data_HOUSE] = h;
            HOUSE_DATA[h][data_OWNED] = 1;
            HOUSE_DATA[h][data_DAY] = 3;
            strmid(HOUSE_DATA[h][data_OWNER], PLAYER_DATA[playerid][data_NAME], 0, strlen(PLAYER_DATA[playerid][data_NAME]), MAX_PLAYER_NAME);
            give_player_money(playerid,-HOUSE_DATA[h][data_PRICE],"#73");
            SendClientMessage(playerid,0xFFCC33FF, "Ïîçäðàâëÿåì Âàñ ñ ïîêóïêîé äîìà! Îí áûë îïëà÷åí íà 3 äíÿ!");
            SendClientMessage(playerid,0xFFCC33FF, "Äëÿ óïðàâëåíèÿ äîìîì èñïîëüçóéòå: /house");
            SendClientMessage(playerid, 0x9F81F7FF, "Èñïîëüçóéòå: /setspawn, ÷òîáû èçìåíèòü ìåñòî ïîÿâëåíèÿ");
            
            
            new logtext[64];
			format(logtext,sizeof(logtext),"êóïèë äîì ID:%d", HOUSE_DATA[h][data_ID]);
			LOG("log_player",PLAYER_DATA[playerid][data_NAME], logtext);
            
            UpdateHouseData(h);
            SaveHouseData(h);
           	SavePlayerData(playerid);
           	return true;
        }
    }
    
    for(new p = 0; p < TotalJB; p++)
    {
        if(PlayerToPoint(3.0, playerid, JB_DATA[p][data_INFO_POS][0], JB_DATA[p][data_INFO_POS][1], JB_DATA[p][data_INFO_POS][2]))
        {
            if(PLAYER_DATA[playerid][data_JB] != INVALID_JB_ID || PLAYER_DATA[playerid][data_BUSINESS] != INVALID_BUSINESS_ID || PLAYER_DATA[playerid][data_AB] != INVALID_AB_ID) return SendClientMessage(playerid,COLOR_WARNING,"Ó Âàñ óæå åñòü áèçíåñ!");
            if(JB_DATA[p][data_OWNED] == 1) return SendClientMessage(playerid,COLOR_WARNING,"Ó äàííîãî ïðåäïðèÿòèÿ óæå åñòü âëàäåëåö!");
			if(get_player_money(playerid) < JB_DATA[p][data_PRICE]) return SendClientMessage(playerid,COLOR_WARNING,"Ó Âàñ íåäîñòàòî÷íî äåíåã íà ðóêàõ!");
            
            PLAYER_DATA[playerid][data_JB] = p;
            JB_DATA[p][data_OWNED] = 1;
            JB_DATA[p][data_BANK] = 0;
            JB_DATA[p][data_SKLAD] = 0;
            strmid(JB_DATA[p][data_OWNER], PLAYER_DATA[playerid][data_NAME], 0, strlen(PLAYER_DATA[playerid][data_NAME]), MAX_PLAYER_NAME);
            give_player_money(playerid,-JB_DATA[p][data_PRICE],"#74");
            
            new str[145];
            format(str,sizeof(str),"Ïîçäðàâëÿåì ñ ïîêóïêîé ïðåäïðèÿòèÿ ÎÎÎ '%s'",JB_DATA[p][data_NAME]);
            SendClientMessage(playerid,0xFFCC33FF, "Äëÿ óïðàâëåíèÿ ïðåäïðèÿòèåì èñïîëüçóéòå: /business");
            
            new logtext[64];
			format(logtext,sizeof(logtext),"êóïèë ïðåäïðèÿòèå ID:%d", JB_DATA[p][data_ID]);
			LOG("log_player",PLAYER_DATA[playerid][data_NAME], logtext);
            
            UpdateJBData(p);
            SaveJBData(p);
           	SavePlayerData(playerid);
           	return true;
        }
    }
    
    for(new p = 0; p < TotalAB; p++)
    {
        if(PlayerToPoint(3.0, playerid, AB_DATA[p][data_INFO_POS][0], AB_DATA[p][data_INFO_POS][1], AB_DATA[p][data_INFO_POS][2]))
        {
            if(PLAYER_DATA[playerid][data_JB] != INVALID_JB_ID || PLAYER_DATA[playerid][data_BUSINESS] != INVALID_BUSINESS_ID || PLAYER_DATA[playerid][data_AB] != INVALID_AB_ID) return SendClientMessage(playerid,COLOR_WARNING,"Ó Âàñ óæå åñòü áèçíåñ!");
            if(AB_DATA[p][data_OWNED] == 1) return SendClientMessage(playerid,COLOR_WARNING,"Ó äàííîé àâòîáàçû óæå åñòü âëàäåëåö!");
			if(get_player_money(playerid) < AB_DATA[p][data_PRICE]) return SendClientMessage(playerid,COLOR_WARNING,"Ó Âàñ íåäîñòàòî÷íî äåíåã íà ðóêàõ!");

            PLAYER_DATA[playerid][data_AB] = p;
            AB_DATA[p][data_OWNED] = 1;
            AB_DATA[p][data_BANK] = 0;
            strmid(AB_DATA[p][data_OWNER], PLAYER_DATA[playerid][data_NAME], 0, strlen(PLAYER_DATA[playerid][data_NAME]), MAX_PLAYER_NAME);
            give_player_money(playerid,-AB_DATA[p][data_PRICE],"#75");
            
            new logtext[64];
			format(logtext,sizeof(logtext),"êóïèë àâòîáàçó ID:%d", AB_DATA[p][data_ID]);
			LOG("log_player",PLAYER_DATA[playerid][data_NAME], logtext);

            new str[145];
            format(str,sizeof(str),"Ïîçäðàâëÿåì ñ ïîêóïêîé àâòîáàçû '%s'",AB_DATA[p][data_NAME]);
            SendClientMessage(playerid,0xFFCC33FF, "Äëÿ óïðàâëåíèÿ àâòîáàçîé èñïîëüçóéòå: /business");
            
            UpdateABData(p);
            SaveABData(p);
           	SavePlayerData(playerid);
           	return true;
        }
    }
    
    
    for(new b = 0; b < TotalBusiness; b++)
    {
        if(PlayerToPoint(3.0, playerid, BUSINESS_DATA[b][data_ENTERX], BUSINESS_DATA[b][data_ENTERY], BUSINESS_DATA[b][data_ENTERZ]))
        {
            if(PLAYER_DATA[playerid][data_JB] != INVALID_JB_ID || PLAYER_DATA[playerid][data_BUSINESS] != INVALID_BUSINESS_ID || PLAYER_DATA[playerid][data_AB] != INVALID_AB_ID) return SendClientMessage(playerid,COLOR_WARNING,"Ó Âàñ óæå åñòü áèçíåñ!");
            if(BUSINESS_DATA[b][data_OWNED] == 1) SendClientMessage(playerid,COLOR_WARNING,"Äàííûé áèçíåñ óæå êóïëåí!");
			if(get_player_money(playerid) < BUSINESS_DATA[b][data_PRICE]) return SendClientMessage(playerid,COLOR_WARNING,"Ó Âàñ íåäîñòàòî÷íî äåíåã íà ðóêàõ!");
			PLAYER_DATA[playerid][data_BUSINESS] = b;
			
			
			new logtext[64];
			format(logtext,sizeof(logtext),"êóïèë áèçíåñ ID:%d", BUSINESS_DATA[b][data_ID]);
			LOG("log_player",PLAYER_DATA[playerid][data_NAME], logtext);

			BUSINESS_DATA[b][data_BANK] = 0;
			BUSINESS_DATA[b][data_PROD] = 0;
            BUSINESS_DATA[b][data_OWNED] = 1;
            BUSINESS_DATA[b][data_DAY] = 3;
            strmid(BUSINESS_DATA[b][data_OWNER], PLAYER_DATA[playerid][data_NAME], 0, strlen(PLAYER_DATA[playerid][data_NAME]), 24);
            give_player_money(playerid,-BUSINESS_DATA[b][data_PRICE],"#76");
            SendClientMessage(playerid,0xFFCC33FF, "Ïîçäðàâëÿåì Âàñ ñ ïîêóïêîé áèçíåñà!	Îí áûë îïëà÷åí íà 3 äíÿ");
            SendClientMessage(playerid,0xFFCC33FF, "Äëÿ óïðàâëåíèÿ áèçíåñîì èñïîëüçóéòå: /business");
            UpdateBusinessData(b);
            SaveBusinessData(b);
           	SavePlayerData(playerid);
           	break;
        }
    }
    
    return true;
}

CMD:business(playerid)
{
    if(antiflood[playerid] > 0) return SendClientMessage(playerid, COLOR_WARNING,"Íå ôëóäè!");
    antiflood[playerid]++;
    if(PLAYER_DATA[playerid][data_LOGGED] == false) return SendClientMessage(playerid,COLOR_WARNING,"Âû íå àâòîðèçîâàíû íà ñåðâåðå!");
    if(PLAYER_DATA[playerid][data_BUSINESS] == INVALID_BUSINESS_ID && PLAYER_DATA[playerid][data_JB] == INVALID_JB_ID && PLAYER_DATA[playerid][data_AB] == INVALID_AB_ID) return SendClientMessage(playerid,COLOR_WARNING,"Ó Âàñ íåò áèçíåñà!");


	if(PLAYER_DATA[playerid][data_JB] != INVALID_BUSINESS_ID)
	{
	    new dtext[512], b = PLAYER_DATA[playerid][data_JB];
	    format(dtext ,sizeof(dtext), "{FFFFFF}Ñòàòèñòèêà ïðåäïðèÿòèÿ\nÓïðàâëåíèå àâòîïàðêîì\nÈçìåíèòü çàðïëàòó ðàáî÷èõ ({66FF66}%d ðóáëåé{FFFFFF})\nÈçìåíèòü çàðïëàòó âîäèòåëåé ({66FF66}%d ðóáëåé{FFFFFF})\nÈçìåíèòü ñòîèìîñòü ýêñïîðòà ðåñóðñîâ\nÑíÿòü äåíüãè ñî ñ÷åòà\nÏîëîæèòü äåíüãè íà ñ÷åò\n{FF0033}Ïðîäàòü ïðåäïðèÿòèå ãîñóäàðñòâó",JB_DATA[b][data_JOB_MONEY], JB_DATA[b][data_BUS_MONEY]);
	    ShowPlayerDialogFix(playerid, dialog_JB, DIALOG_STYLE_LIST, "{FFCC00}Ïðåäïðèÿòèå", dtext, "Âûáðàòü", "Îòìåíà");

	}
	else if(PLAYER_DATA[playerid][data_AB] != INVALID_AB_ID)
	{
	    new dtext[512], b = PLAYER_DATA[playerid][data_AB];
	    format(dtext ,sizeof(dtext), "{FFFFFF}Ñòàòèñòèêà àâòîáàçû\nÓïðàâëåíèå àâòîïàðêîì\nÈçìåíèòü ïðîöåíò çàðïëàòû âîäèòåëåé ({66FF66}%d ïðîöåíòîâ{FFFFFF})\nÑíÿòü äåíüãè ñî ñ÷åòà\nÏîëîæèòü äåíüãè íà ñ÷åò\n{FF0033}Ïðîäàòü àâòîáàçó ãîñóäàðñòâó",AB_DATA[b][data_PROCENT]);
	    ShowPlayerDialogFix(playerid, dialog_AB, DIALOG_STYLE_LIST, "{FFCC00}Àâòîáàçà", dtext, "Âûáðàòü", "Îòìåíà");
	}
	else if(PLAYER_DATA[playerid][data_BUSINESS] != INVALID_BUSINESS_ID)
	{
	    Business_Panel(playerid);
	}
	return true;
}

