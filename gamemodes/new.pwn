		SendClientMessage(params[0], 0xDD90FFFF, str2);
	}
	else SendClientMessage(playerid, COLOR_WARNING,"Äàííàÿ ôóíêöèÿ äîñòóïíà òîëüêî îñíîâàòåëþ ïàðòèè!");
