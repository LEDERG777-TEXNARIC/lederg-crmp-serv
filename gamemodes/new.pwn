		{
		    format(string,sizeof(string),"%s{FFFFFF}[%d] %s, êðûøà: %s, âëàäåëåö: %s\n",string,b+1,BUSINESS_DATA[b][data_NAME],mafia,BUSINESS_DATA[b][data_OWNER]);
		}
    }
    ShowPlayerDialogFix(playerid,dialog_OK, DIALOG_STYLE_MSGBOX, "{FFCC00}Ñïèñîê áèçíåñîâ", string, "Çàêðûòü", "");
