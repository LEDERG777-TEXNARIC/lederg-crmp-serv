CMD:tpc(playerid)
{
    if(antiflood[playerid] > 0) return SendClientMessage(playerid, COLOR_WARNING,"Íå ôëóäè!");
    antiflood[playerid]++;
    if(PLAYER_DATA[playerid][data_LOGGED] == false) return SendClientMessage(playerid,COLOR_WARNING,"Âû íå àâòîðèçîâàíû íà ñåðâåðå!");
    if(PLAYER_DATA[playerid][data_ADMLVL] < 7) return true;
	if(GetPVarInt(playerid, "addkv") == 0 && GetPVarInt(playerid, "addhouse") == 0) return SendClientMessage(playerid,COLOR_WARNING,"Âû íå íà÷àëè äîáàâëÿòü ïîäúåçä!");
	if(IsPlayerInAnyVehicle(playerid) && GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
	{
	    new currentveh = GetPlayerVehicleID(playerid),Float:vehx, Float:vehy, Float:vehz, Float:z_rot;
      	GetVehiclePos(currentveh, vehx, vehy, vehz);
   	 	GetVehicleZAngle(currentveh, z_rot);
      	SetPVarFloat(playerid,"aCarX",vehx);
      	SetPVarFloat(playerid,"aCarY",vehy);
      	SetPVarFloat(playerid,"aCarZ",vehz);
      	SetPVarFloat(playerid,"aCarAngle",z_rot);
      	DestroyVehicle(currentveh);
      	SendClientMessage(playerid,-1, "Âñòàíüòå íà ìåñòî, ãäå áóäåò íàõîäèòüñÿ ïîäúåçä è ââåäèòå /tpkv");
	}
	return true;
}

CMD:free(playerid,params[])
{
    if(antiflood[playerid] > 0) return SendClientMessage(playerid, COLOR_WARNING,"Íå ôëóäè!");
    antiflood[playerid]++;
    if(PLAYER_DATA[playerid][data_LOGGED] == false) return SendClientMessage(playerid,COLOR_WARNING,"Âû íå àâòîðèçîâàíû íà ñåðâåðå!");
    if(PLAYER_DATA[playerid][data_MEMBER] == 1 && PLAYER_DATA[playerid][data_RANK] == 4)
	{
    	if(sscanf(params, "u",params[0])) return SendClientMessage(playerid,COLOR_WARNING,"Èñïîëüçóéòå: /free [èä]");
    	if(!IsPlayerConnected(params[0]))return  SendClientMessage(playerid,COLOR_WARNING,"Äàííîãî ID íåò íà ñåðâåðå!");
		if(PLAYER_DATA[params[0]][data_LOGGED] == false) return  SendClientMessage(playerid,COLOR_WARNING,"Äàííûé èãðîê íå ïðîøåë àâòîðèçàöèþ!");
		new Float:x,Float:y,Float:z;
		GetPlayerPos(params[0],x,y,z);
		if(!PlayerToPoint(10.0, playerid, x,y,z)) return SendClientMessage(playerid,COLOR_WARNING,"Âû íàõîäèòåñü äàëåêî îò äàííîãî èãðîêà!");
		if(PLAYER_DATA[params[0]][data_JAIL] == 0) return SendClientMessage(playerid,COLOR_WARNING,"Äàííûé èãðîê íå íàõîäèòñÿ â òþðüìå!");
		switch(PLAYER_DATA[params[0]][data_JAILTIME])
		{
			case 0..600: SetPVarInt(params[0],"free_money",1000);
			case 601..1200: SetPVarInt(params[0],"free_money",2500);
			case 1201..1800: SetPVarInt(params[0],"free_money",5000);
			case 1801..3600: SetPVarInt(params[0],"free_money",10000);
		}
		SetPVarInt(params[0], "yesno_free", 1);
	    SetPVarInt(params[0], "yesno_playerid", playerid);
	    SetPVarInt(params[0], "yesno", 1);
		new str1[145], str2[145];
		format(str1,sizeof(str1),"Âû ïðåäëîæèëè âûéòè èç òþðüìû èãðîêó %s çà %d ðóáëåé",PLAYER_DATA[params[0]][data_NAME],GetPVarInt(params[0],"free_money"));
		SendClientMessage(playerid, 0xDD90FFFF, str1);
		format(str2,sizeof(str2),"Àäâîêàò %s ïðåäëîæèë Âàì âûéòè èç òþðüìû çà %d ðóáëåé. Äëÿ ñîãëàñèÿ {31B404}Y{FF66CC}, äëÿ îòêàçà íàæìèòå {FE2E2E}N",PLAYER_DATA[playerid][data_NAME],GetPVarInt(params[0],"free_money"));
		SendClientMessage(params[0], 0xDD90FFFF, str2);
    }
    else SendClientMessage(playerid,COLOR_WARNING,"Âàì íåäîñòóïíà äàííàÿ êîìàíäà!");
	return true;
}

CMD:licsell(playerid,params[])
{
    if(antiflood[playerid] > 0) return SendClientMessage(playerid, COLOR_WARNING,"Íå ôëóäè!");
    antiflood[playerid]++;
    if(PLAYER_DATA[playerid][data_LOGGED] == false) return SendClientMessage(playerid,COLOR_WARNING,"Âû íå àâòîðèçîâàíû íà ñåðâåðå!");
    if(PLAYER_DATA[playerid][data_MEMBER] == 1 && PLAYER_DATA[playerid][data_RANK] == 3)
	{
		if(sscanf(params, "ud", params[0],params[1])) return SendClientMessage(playerid, COLOR_WARNING, "Èñïîëüçóéòå: /licsell [id] [1 - âîäèòåëüñêèå ïðàâà, 2 - ëèöåíçèÿ íà îðóæèå]");
		if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid,COLOR_WARNING,"Äàííîãî ID íåò íà ñåðâåðå!");
		if(PLAYER_DATA[params[0]][data_LOGGED] == false) return SendClientMessage(playerid,COLOR_WARNING,"Äàííûé èãðîê íå ïðîøåë àâòîðèçàöèþ!");
		if(params[1] < 1 || params[1] > 2) return SendClientMessage(playerid, COLOR_WARNING, "Èñïîëüçóéòå: /licsell [id] [1 - âîäèòåëüñêèå ïðàâà, 2 - ëèöåíçèÿ íà îðóæèå]");
		new Float:x,Float:y,Float:z;
		GetPlayerPos(params[0],x,y,z);
		if(!PlayerToPoint(10.0, playerid, x,y,z)) return SendClientMessage(playerid,COLOR_WARNING,"Äàííûé èãðîê äàëåêî îò Âàñ!");
		if(GetPVarInt(params[0],"yesno") == 1) return SendClientMessage(playerid,COLOR_WARNING,"Èãðîêó óæå ïîñòóïèëî ïðåäëîæåíèå!");
		if(params[1] == 1)
		{
			if(PLAYER_DATA[params[0]][data_LICB] == 1) return SendClientMessage(playerid, COLOR_WARNING, "Ó èãðîêà óæå åñòü âîäèòåëüñêèå ïðàâà!");
			new str1[145], str2[145];
			format(str1,sizeof(str1),"Âû ïðåäëîæèëè êóïèòü âîäèòåëüñêèå ïðàâà èãðîêó %s çà 5000 ðóáëåé",PLAYER_DATA[params[0]][data_NAME]);
			SendClientMessage(playerid, 0xDD90FFFF, str1);
			format(str2,sizeof(str2),"%s ïðåäëîæèë Âàì êóïèòü âîäèòåëüñêèå ïðàâà çà 5000 ðóáëåé. Äëÿ ñîãëàñèÿ {31B404}Y{FF66CC}, äëÿ îòêàçà íàæìèòå {FE2E2E}N",PLAYER_DATA[playerid][data_NAME]);
			SendClientMessage(params[0], 0xDD90FFFF, str2);
		}
		else
		{
		    if(PLAYER_DATA[params[0]][data_LICG] == 1) return SendClientMessage(playerid, COLOR_WARNING, "Ó èãðîêà óæå åñòü ëèöåíçèÿ íà îðóæèå!");
			new str1[145], str2[145];
			format(str1,sizeof(str1),"Âû ïðåäëîæèëè êóïèòü ëèöåíçèþ íà îðóæèå èãðîêó %s çà 30000 ðóáëåé",PLAYER_DATA[params[0]][data_NAME]);
			SendClientMessage(playerid, 0xDD90FFFF, str1);
			format(str2,sizeof(str2),"%s ïðåäëîæèë Âàì êóïèòü ëèöåíçèþ íà îðóæèå çà 30000 ðóáëåé. Äëÿ ñîãëàñèÿ {31B404}Y{FF66CC}, äëÿ îòêàçà íàæìèòå {FE2E2E}N",PLAYER_DATA[playerid][data_NAME]);
			SendClientMessage(params[0], 0xDD90FFFF, str2);
		}
	    SetPVarInt(params[0], "yesno_licsell", 1);
	    SetPVarInt(params[0], "licsell", params[1]);
	    SetPVarInt(params[0], "yesno_playerid", playerid);
	    SetPVarInt(params[0], "yesno", 1);
	}
	else SendClientMessage(playerid,COLOR_WARNING,"Âàì íåäîñòóïíà äàííàÿ êîìàíäà!");
	return true;
}

CMD:tpkv(playerid)
