			if(AB_DATA[b][data_OWNED] == 1)
			{
		        format(str,sizeof(str),"{FFFFFF}Àâòîáàçà '%s'\n{FFFF33}Âëàäåëåö: {FFFFFF}%s\n{FFFF33}Ñòîèìîñòü: {FFFFFF}%d ðóáëåé\n{FFFF33}Çàðïëàòà âîäèòåëÿ: {FFFFFF}%d ïðîöåíò(îâ)", AB_DATA[b][data_NAME], AB_DATA[b][data_OWNER], AB_DATA[b][data_PRICE], AB_DATA[b][data_PROCENT]);
			 	AB_DATA[b][data_INFO] = CreateDynamic3DTextLabel(str, -1, AB_DATA[b][data_INFO_POS][0], AB_DATA[b][data_INFO_POS][1], AB_DATA[b][data_INFO_POS][2], 5.0);
			}
			else
			{
		        format(str,sizeof(str),"{FFFFFF}Àâòîáàçà '%s'\n{FFFF33}Ñòîèìîñòü: {FFFFFF}%d ðóáëåé\n{99FFFF}Äëÿ ïîêóïêè èñïîëüçóéòå: /buy", AB_DATA[b][data_NAME], AB_DATA[b][data_PRICE]);
			 	AB_DATA[b][data_INFO] = CreateDynamic3DTextLabel(str, -1, AB_DATA[b][data_INFO_POS][0], AB_DATA[b][data_INFO_POS][1], AB_DATA[b][data_INFO_POS][2], 5.0);
			}
        }
        printf("[serv_log]  Load auto business. Load: %d b. Time: %d ms.",TotalAB,GetTickCount()-time);
  	}
    return true;
}

