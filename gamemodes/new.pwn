				if(PLAYER_DATA[playerid][data_RENTJOB] != carid) return ShowPlayerDialogFix(playerid, dialog_RENTJOB, DIALOG_STYLE_MSGBOX, "{FFCC00}Ïðåäïðèÿòèå", "{FFFFFF}Âû æåëàåòå íà÷àòü ðàáî÷èé äåíü íà äàííîì òðàíñïîðòå?", "Íà÷àòü", "Îòìåíà");
			}
        }
        
        
        if(carid >= prod_car[0] && carid <= prod_car[1])
		{
			if(PLAYER_DATA[playerid][data_START_JOB] != 8)
			{
				SendClientMessage(playerid,COLOR_WARNING,"Äàííûé òðàíñïîðò Âàì íåäîñòóïåí!");
