public LoadPolitMember(polit, playerid)
{
    new rows, fields;
    cache_get_data(rows, fields);
    if(rows)
    {
        new name[MAX_PLAYER_NAME],dtext[512];
    	for(new p = 0; p < rows; p++)
    	{
	        cache_get_field_content(p, "name", name, dbHandle, MAX_PLAYER_NAME);
	        if(strfind(POLIT_TEAM[polit][data_OWNER], name, true) != -1) format(dtext,sizeof(dtext),"%s\n{FFFFFF}%s - Îñíîâàòåëü",dtext, name);
	        else format(dtext,sizeof(dtext),"%s\n{FFFFFF}%s\n",dtext, name);
        }
    	ShowPlayerDialogFix(playerid, dialog_OK, DIALOG_STYLE_MSGBOX, "{FFCC00}Ñîñòàâ ïàðòèè", dtext, "Çàêðûòü", "");
	}
	return true;
}

