			if(PLAYER_DATA[playerid][data_RENTJOB] != carid) return ShowPlayerDialogFix(playerid, dialog_RENTJOB, DIALOG_STYLE_MSGBOX, "{FFCC00}Ãëàâíûé ñêëàä", "{FFFFFF}Âû æåëàåòå íà÷àòü ðàáî÷èé äåíü íà äàííîì òðàíñïîðòå?", "Íà÷àòü", "Îòìåíà");
		}
		
        if(carid >= gov_car[0] && carid <= gov_car[1])
