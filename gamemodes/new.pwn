	format(str,sizeof(str),"{FFFFFF}Î÷êè îïûòà:\t\t\t%d èç %d\n",PLAYER_DATA[playerid][data_EXP], nextexp);
	strcat(sctring,str);
	format(str,sizeof(str),"{FFFFFF}Íîìåð òåëåôîíà:\t\t%s\n",number_text);
