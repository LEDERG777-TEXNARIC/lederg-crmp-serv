stock PlayerToKvadrat(playerid, Float:min_x, Float:min_y, Float:max_x, Float:max_y)
{
	new Float:xxp,Float:yyp,Float:zzp;
	GetPlayerPos(playerid, xxp, yyp, zzp);
	if((xxp <= max_x && xxp >= min_x) && (yyp <= max_y && yyp >= min_y)) return true;
	return false;
}

stock EmailCode(playerid, email[])
{
    new ftext[145];
	PLAYER_DATA[playerid][data_ECODE] = random(9999);
	format(ftext,sizeof(ftext),"Êîä: %d",PLAYER_DATA[playerid][data_ECODE],email);
	//SendMail(email, "support@ragerp.ru", "Rage RolePlay", "Code", ftext);
	SendClientMessage(playerid,-1,ftext);
}

stock ShowPlayerDialogFix(playerid, dialogid, style, caption[], info[], button1[], button2[])
{
    if(GetPVarInt(playerid, "DialogID") != -2) return true;
    if(dialogid == -1) SetPVarInt(playerid, "DialogID", -2);
    SetPVarInt(playerid, "DialogID", dialogid);
    return ShowPlayerDialog(playerid, dialogid, style, caption, info, button1, button2);
}

stock Dialog_PLAYER_REGISTER(playerid)
{
	ShowPlayerDialogFix(playerid, dialog_REGISTER, DIALOG_STYLE_PASSWORD, "{66CCFF}Ðåãèñòðàöèÿ","{FFFFFF}Äîáðî ïîæàëîâàòü íà ñåðâåð {66CCFF}LEDERG PROJECT\n{FFFFFF}×òîáû íà÷àòü èãðó Âàì íåîáõîäèìî ïðîéòè ðåãèñòðàöèþ\n\nÂâåäèòå ïàðîëü äëÿ Âàøåãî àêêàóíòà â íèæíåå îêîøêî\nÎí áóäåò çàïðàøèâàòüñÿ êàæäûé ðàç ïðè âõîäå íà ñåðâåð\n\n{66CC33}\tÏðèìè÷àíèÿ:\n\t- Ïàðîëü ìîæåò ñîñòîÿòü èç ëàòèíñêèõ áóêâ è öèôð\n\t- Äëèíà ïàðîëÿ îò 6-òè äî 30-òè ñèìâîëîâ\n\t- Ïàðîëü ÷óâñòâèòåëåí ê ðåãèñòðó", "Äàëåå","");
    return true;
}
stock Dialog_PLAYER_LOGIN(playerid)
{
    new dtext[256];
	format(dtext,sizeof(dtext),"{FFFFFF}Äîáðî ïîæàëîâàòü íà ñåðâåð {339966}LEDERG PROJECT\n{FFFFFF}\nÂàø ëîãèí: {FF3300}%s\n{FFFFFF}Äëÿ íà÷àëà èãðû íóæíî ââåñòè ïàðîëü â îêîøêî",PLAYER_DATA[playerid][data_NAME]);
	ShowPlayerDialogFix(playerid, dialog_LOGIN, DIALOG_STYLE_PASSWORD, "{66CCFF}Àâòîðèçàöèÿ",dtext,"Âîéòè","");
	return true;
}

stock ClearCarData(car)
{
	CAR_DATA[car][data_LOCK] = 0;
	CAR_DATA[car][data_ENG] = 0;
	CAR_DATA[car][data_LAMP] = 0;
	CAR_DATA[car][data_ASH_TEST] = INVALID_PLAYER_ID;
	CAR_DATA[car][data_RENT] = INVALID_PLAYER_ID;
	CAR_DATA[car][data_KOLVO] = 0;
	CAR_DATA[car][data_GRUZ] = 0;
	CAR_DATA[car][data_PATR] = 0;
	CAR_DATA[car][data_MET] = 0;
	//CAR_DATA[car][data_CREATE] = 0;
	return true;
}


stock ShowStats(playerid)
{
	new sex_text[8], polit_stat[5],podfrak[6],sctring[700], str[256],org_text[20],number_text[12],hous[20],kvs[20],kkvs[20],bis[20],abis[20],jbis[25],status[20];
	switch(PLAYER_DATA[playerid][data_POLIT])
	{
	    case 0: polit_stat = "Íåò";
	    default: polit_stat = "Åñòü";
	}
	switch(PLAYER_DATA[playerid][data_NUMBER])
	{
	    case 0: number_text = "Íåò";
	    default: format(number_text,sizeof(number_text),"%d",PLAYER_DATA[playerid][data_NUMBER]);
	}
	switch(PLAYER_DATA[playerid][data_LVL])
	{
		case 1..3: status = "Íîâè÷îê";
		case 4..9: status = "Îñâîèâøèéñÿ";
		default: status = "Îïûòíûé";

	}
	
	switch(PLAYER_DATA[playerid][data_PADIK])
	{
		case INVALID_KV_ID: kvs = "Íåò";
		default: format(kvs,sizeof(kvs),"¹%d",PLAYER_DATA[playerid][data_PADIK]+1);
	}
	
	switch(PLAYER_DATA[playerid][data_KV])
	{
		case INVALID_KV_ID: kkvs = "Íåò";
		default: format(kkvs,sizeof(kkvs),"¹%d",PLAYER_DATA[playerid][data_KV]+1);
	}
	
	switch(PLAYER_DATA[playerid][data_HOUSE])
	{
		case INVALID_HOUSE_ID: hous = "Íåò";
		default: format(hous,sizeof(hous),"¹%d",PLAYER_DATA[playerid][data_HOUSE]+1);
	}
	switch(PLAYER_DATA[playerid][data_BUSINESS])
	{
