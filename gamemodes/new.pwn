	format(string,sizeof(string),"1. Ïîäíÿòü ðóêè ââåðõ\n2. Êóðèòü\n3. Ìûòü ðóêè\n4. Ñåñòü íà çåìëþ\n5. Ëå÷ü íà ñïèíó\n6. Ëå÷ü è ïðèïîäíÿòü íîãó\n7. ×èòàòü ðýï \n8. Ïðèëå÷ü\n9. Óñòàíîâèòü áîìáó\n10. Ïîçà âðàòàðÿ\n11. Ñëîæèòü ðóêè\n12. Ïëàêàòü (äåâóøêà)\n13. Ïüÿíàÿ ïîõîäêà\n14. Ãîëîñîâàòü\n15. Ïîäíÿòü ðóêó\n16. Ïîäíÿòü ðóêè\n17. Îáëîêîòèòüñÿ\n18. Ñìîòðåòü íà íåáî\n19. Ìàõàòü ðóêîé\n20. Áîëåëüùèê\n21. Ìåäèòàöèÿ\n22. Facepalm\n23. Çàëîæíèê");
	ShowPlayerDialogFix(playerid,dialog_ANIM,DIALOG_STYLE_LIST,"{FFCC00}Ñïèñîê àíèìàöèé:", string, "Âûáðàòü","Îòìåíà");
	return true;
}


